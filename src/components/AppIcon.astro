---
import type { Product } from "@/data/products";

interface Props {
  product: Product;
  size?: number;
  class?: string;
}
const { product, size = 56, class: className } = Astro.props;
const radius = Math.round(size * 0.24);
---

{product.icon ? (
  <img
    src={product.icon}
    alt=""
    width={size}
    height={size}
    class:list={["shrink-0 shadow-sm ring-1 ring-black/5", className]}
    style={`border-radius:${radius}px`}
    loading="lazy"
  />
) : (
  <span
    class:list={["grid shrink-0 place-items-center font-semibold text-white shadow-sm ring-1 ring-black/5", className]}
    style={`width:${size}px;height:${size}px;border-radius:${radius}px;font-size:${size * 0.46}px;background:linear-gradient(145deg, ${product.accent}, color-mix(in oklab, ${product.accent} 55%, #101057))`}
    aria-hidden="true"
  >
    {product.monogram}
  </span>
)}
