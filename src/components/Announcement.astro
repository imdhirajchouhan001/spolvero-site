---
// Full-width bar above the header, in the spirit of the reference site's top strip.
// Set `announcement` to null in src/data/announcement.ts to remove it everywhere.
import Icon from "@/components/Icon.astro";
import { announcement } from "@/data/announcement";
---

{announcement && (
  <div class="bg-brand-section text-center" data-announcement>
    <div class="container-page flex items-center justify-center gap-3 py-2.5">
      <p class="text-sm font-medium text-primary_on-brand md:text-md">
        {announcement.text}
        <a href={announcement.href} class="ml-2 inline-flex items-center gap-1 font-semibold underline underline-offset-4 hover:no-underline">
          {announcement.cta}
          <Icon name="arrow" class="size-4" />
        </a>
      </p>
    </div>
  </div>
)}
