---
import "@/styles/global.css";
import AdInterrupt from "@/components/AdInterrupt.astro";
import Announcement from "@/components/Announcement.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { adsenseClient } from "@/data/ads";
import { navGroups, navLinks } from "@/data/nav";

interface Props {
  title: string;
  description: string;
  image?: string;
  themeColor?: string;
  noindex?: boolean;
  headerCta?: { label: string; href: string };
}

const { title, description, image = "/assets/brand/og.png", themeColor = "#101057", noindex = false, headerCta } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const site = Astro.site!.toString();

// Site-wide structured data, emitted once per page: who publishes this, what the site is,
// and the sections search engines should treat as the main navigation.
const siteJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${site}#organization`,
    name: "Spolvero",
    url: site,
    logo: new URL("/assets/brand/mark.svg", site).toString(),
    email: "spolvero.design@gmail.com",
    description: "An independent studio designing and building apps, games, web tools and software.",
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${site}#website`,
    name: "Spolvero",
    url: site,
    publisher: { "@id": `${site}#organization` },
    inLanguage: "en",
  },
  ...navGroups.concat(navLinks.map((l) => ({ label: l.label, href: l.href, blurb: "", items: [] }))).map((g) => ({
    "@context": "https://schema.org",
    "@type": "SiteNavigationElement",
    name: g.label,
    url: new URL(g.href, site).toString(),
  })),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
    <meta property="og:locale" content="en" />
    <meta name="author" content="Spolvero" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Spolvero" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/brand/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- The site is light only for now. The dark token set is still defined in
         global.css and theme.css; to bring it back, restore the stored-preference
         script here and put <ThemeToggle /> back in the header. -->
    <meta name="color-scheme" content="light" />
    <script is:inline>
      // Content is hidden until the reveal animation runs. This inline script has no
      // imports, so it cannot fail to load: if the animation module has not marked
      // itself ready shortly after load, drop the class and show everything as plain
      // HTML. Without this, one failed chunk would render every page blank.
      document.documentElement.classList.add("js");
      setTimeout(function () {
        if (!document.documentElement.dataset.revealReady) document.documentElement.classList.remove("js");
      }, 4000);
    </script>
    <!-- Google Analytics 4 with Consent Mode v2: no ad cookies anywhere; no analytics cookies in the EEA, UK and Switzerland without consent. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("consent", "default", { ad_storage: "denied", ad_user_data: "denied", ad_personalization: "denied", analytics_storage: "granted" });
      gtag("consent", "default", {
        ad_storage: "denied", ad_user_data: "denied", ad_personalization: "denied", analytics_storage: "denied",
        region: ["AT","BE","BG","HR","CY","CZ","DK","EE","FI","FR","DE","GR","HU","IS","IE","IT","LV","LI","LT","LU","MT","NL","NO","PL","PT","RO","SK","SI","ES","SE","GB","CH"],
      });
      gtag("js", new Date());
      gtag("config", "G-WS3JP0LJ3M");
    </script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-WS3JP0LJ3M"></script>
    <!-- Microsoft Clarity. Visitors whose timezone is in Europe get no Clarity cookies (Consent API v2); typed text is masked by Clarity by default. -->
    <script is:inline>
      (function (c, l, a, r, i, t, y) {
        c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
        var eu = /^(Europe|Atlantic\/(Reykjavik|Canary|Madeira|Azores|Faroe))\//.test(Intl.DateTimeFormat().resolvedOptions().timeZone || "");
        c[a]("consentv2", { ad_Storage: "denied", analytics_Storage: eu ? "denied" : "granted" });
        t = l.createElement(r); t.async = 1; t.src = "https://www.clarity.ms/tag/" + i;
        y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
      })(window, document, "clarity", "script", "yjjrmtb5mx");
    </script>
    {adsenseClient && (
      <>
        <script
          is:inline
          async
          crossorigin="anonymous"
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
        ></script>
        <!-- Lazy fill: a unit only requests an ad near the viewport, and the unit under the
             tool waits for a finished test. An unfilled or blocked unit collapses to nothing. -->
        <script is:inline>
          addEventListener("DOMContentLoaded", function () {
            var slots = Array.prototype.slice.call(document.querySelectorAll("[data-ad-slot]"));
            if (!slots.length) return;
            function fill(el) {
              if (el.dataset.adFilled !== undefined) return;
              el.dataset.adFilled = "";
              try {
                (window.adsbygoogle = window.adsbygoogle || []).push({});
              } catch (e) {
                el.dataset.adEmpty = "";
                return;
              }
              var ins = el.querySelector("ins.adsbygoogle");
              if (!ins) return;
              setTimeout(function () {
                if (ins.getAttribute("data-ad-status") === "unfilled" || !ins.firstElementChild) el.dataset.adEmpty = "";
              }, 2500);
            }
            var io = new IntersectionObserver(function (entries) {
              entries.forEach(function (e) {
                if (!e.isIntersecting) return;
                var el = e.target;
                if (el.dataset.adAfterResult !== undefined && el.dataset.adReady === undefined) return;
                io.unobserve(el);
                fill(el);
              });
            }, { rootMargin: "200px" });
            slots.forEach(function (el) { io.observe(el); });
            document.addEventListener("spolvero:result", function () {
              slots.filter(function (el) { return el.dataset.adAfterResult !== undefined; }).forEach(function (el) {
                el.dataset.adReady = "";
                if (el.getBoundingClientRect().top < innerHeight + 200) { io.unobserve(el); fill(el); }
              });
            });
          });
        </script>
      </>
    )}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-secondary text-primary">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-primary focus:px-4 focus:py-2 focus:shadow-lg">Skip to content</a>
    <Announcement />
    <Header cta={headerCta} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <AdInterrupt />
    <script>
      import "flowbite";
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";
      gsap.registerPlugin(ScrollTrigger);

      // Tells the inline fallback above that the animation is alive.
      document.documentElement.dataset.revealReady = "1";

      const mm = gsap.matchMedia();
      mm.add("(prefers-reduced-motion: no-preference)", () => {
        // Anything already on screen animates in straight away. Waiting for a scroll
        // trigger to notice it leaves the first screenful blank for a moment, which is
        // the part of the page the visitor is actually looking at.
        const onScreen = gsap.utils
          .toArray<HTMLElement>("[data-reveal]")
          .filter((el) => el.getBoundingClientRect().top < window.innerHeight * 0.95);
        if (onScreen.length) {
          gsap.to(onScreen, { opacity: 1, y: 0, duration: 0.8, ease: "power3.out", stagger: 0.08, overwrite: true });
          onScreen.forEach((el) => el.removeAttribute("data-reveal"));
        }

        ScrollTrigger.batch("[data-reveal]", {
          start: "top 88%",
          once: true,
          onEnter: (els) =>
            gsap.to(els, { opacity: 1, y: 0, duration: 0.8, ease: "power3.out", stagger: 0.08, overwrite: true }),
        });
      });
      // Safety net: never leave content hidden if a trigger doesn't fire.
      window.addEventListener("load", () => {
        setTimeout(() => {
          document.querySelectorAll<HTMLElement>("[data-reveal]").forEach((el) => {
            const r = el.getBoundingClientRect();
            if (r.top < innerHeight && getComputedStyle(el).opacity === "0") gsap.to(el, { opacity: 1, y: 0, duration: 0.5 });
          });
        }, 1500);
      });
    </script>
  </body>
</html>
