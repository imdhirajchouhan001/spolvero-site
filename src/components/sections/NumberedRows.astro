---
// The 01 / 02 / 03 rows from the aviation board: a number, a short title, and a
// description in its own column, separated by rules rather than boxed in cards.
interface Props {
  items: { title: string; body: string }[];
  class?: string;
}
const { items, class: className } = Astro.props;
---

<ol class:list={["flex flex-col", className]}>
  {items.map((it, i) => (
    <li class="grid grid-cols-[auto_1fr] items-start gap-x-4 gap-y-1 border-t border-secondary py-5 md:grid-cols-[auto_1fr_1.2fr] md:gap-x-8 md:py-6" data-reveal>
      <span class="grid size-8 place-items-center rounded-full border border-[var(--border)] text-sm font-semibold text-tertiary tabular-nums" aria-hidden="true">
        {String(i + 1).padStart(2, "0")}
      </span>
      <h3 class="self-center text-lg font-semibold text-primary md:text-xl">{it.title}</h3>
      <p class="col-start-2 text-md text-tertiary md:col-start-3 md:self-center">{it.body}</p>
    </li>
  ))}
</ol>
