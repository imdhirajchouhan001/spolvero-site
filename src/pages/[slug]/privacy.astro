---
import { getCollection, render } from "astro:content";
import Base from "@/layouts/Base.astro";
import AppIcon from "@/components/AppIcon.astro";
import { products } from "@/data/products";

export async function getStaticPaths() {
  const policies = await getCollection("policies");
  return products
    .filter((p) => p.policy)
    .map((p) => ({ params: { slug: p.slug }, props: { product: p, entry: policies.find((e) => e.id === p.policy)! } }));
}

const { product, entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={`${entry.data.title} — Spolvero`} description={`What ${product.name} collects, why, and the control you have over it.`}>
  <section class="bg-primary py-16 md:py-24">
    <div class="container-page">
      <div class="mx-auto flex max-w-3xl flex-col items-center text-center">
        <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm font-semibold text-tertiary">
          <a href={`/${product.slug}/`} class="hover:text-tertiary_hover">{product.name}</a>
          <span aria-hidden="true">/</span>
          <span class="text-brand-secondary">Privacy policy</span>
        </nav>
        <AppIcon product={product} size={56} class="mt-8" />
        <h1 class="mt-5 text-display-md font-semibold text-primary md:text-display-lg">Privacy policy</h1>
        <p class="mt-4 text-lg text-tertiary md:text-xl">{product.storeName} · Effective {entry.data.effective}</p>
      </div>
      <article class="prose mx-auto mt-12 max-w-3xl md:prose-lg md:mt-16 [&_a]:break-words [&_table]:block [&_table]:overflow-x-auto">
        <Content />
      </article>
    </div>
  </section>
</Base>
