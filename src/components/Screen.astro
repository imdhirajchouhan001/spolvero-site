---
import type { Product, Screenshot } from "@/data/products";
import { IPhoneMockup } from "@/components/shared-assets/iphone-mockup";

interface Props {
  product: Product;
  shot: Screenshot;
  class?: string;
}
const { product, shot, class: className } = Astro.props;
---

{product.framed ? (
  <div class:list={["shot", className]}>
    <img src={shot.src} alt={shot.alt} class="block h-auto w-full" loading="lazy" decoding="async" />
  </div>
) : (
  <div class:list={["drop-shadow-2xl", className]} role="img" aria-label={shot.alt}>
    <IPhoneMockup image={shot.src} theme="light" className="h-auto w-full" aria-hidden="true" />
  </div>
)}
