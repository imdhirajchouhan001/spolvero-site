---
import { buttonVariants } from "@/components/ui/button";

interface Props {
  cta?: { label: string; href: string };
}
const { cta = { label: "Contact", href: "/contact/" } } = Astro.props;
const links = [
  { label: "Apps", href: "/#apps" },
  { label: "Studio", href: "/#studio" },
  { label: "Coming up", href: "/#next" },
];
---

<header class="sticky top-0 z-40 border-b border-transparent bg-background/75 backdrop-blur-xl transition-colors" data-header>
  <div class="page flex h-16 items-center justify-between gap-6">
    <a href="/" aria-label="Spolvero home" class="text-brand">
      <span class="logo-mark w-[112px] sm:w-[124px]"></span>
    </a>
    <nav aria-label="Main" class="flex items-center gap-1 text-sm">
      {links.map((l, i) => (
        <a href={l.href} class:list={["rounded-full px-2.5 py-2 text-muted-foreground transition-colors hover:text-foreground sm:px-3", i === 1 && "hidden sm:block", i === 2 && "hidden md:block"]}>
          {l.label}
        </a>
      ))}
      <a href={cta.href} class:list={[buttonVariants({ size: "lg" }), "ml-1 rounded-full px-4 sm:ml-2"]}>{cta.label}</a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const onScroll = () => header?.classList.toggle("border-border", window.scrollY > 8);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>
