---
import type { Product, Screenshot } from "@/data/products";

interface Props {
  product: Product;
  shot: Screenshot;
  class?: string;
  eager?: boolean;
}
const { product, shot, class: className, eager = false } = Astro.props;
---

<div class:list={[product.framed ? "shot" : "phone", className]}>
  <img
    src={shot.src}
    alt={shot.alt}
    class="block h-auto w-full"
    loading={eager ? "eager" : "lazy"}
    decoding="async"
  />
</div>
