---
import Base from "@/layouts/Base.astro";
import VoiceRecorder from "@/components/audio/VoiceRecorder.astro";
import Troubleshoot from "@/components/tools/Troubleshoot.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import RelatedGuides from "@/components/RelatedGuides.astro";
import Faq from "@/components/Faq.astro";
import Icon from "@/components/Icon.astro";
import AdSlot from "@/components/AdSlot.astro";
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import { voiceRecorder as v, formatGuide, loudnessTargets, recorderHowTo } from "@/data/audio";
import { tools } from "@/data/tools";

const site = Astro.site!.toString();
const url = new URL("/tools/voice-recorder/", site).toString();
const related = tools.filter((t) => ["mic-test", "speaker-test", "webcam-test"].includes(t.slug));

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site },
      { "@type": "ListItem", position: 2, name: "Tools", item: new URL("/tools/", site).toString() },
      { "@type": "ListItem", position: 3, name: v.name, item: url },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: `Spolvero ${v.name}`,
    applicationCategory: "MultimediaApplication",
    applicationSubCategory: "Voice recorder",
    operatingSystem: "Web browser: Chrome, Safari, Firefox, Edge",
    browserRequirements: "Requires microphone permission",
    url,
    description: v.description,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    publisher: { "@type": "Organization", name: "Spolvero", url: site },
    isAccessibleForFree: true,
    permissions: "microphone",
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "How to record your voice online and download it",
    totalTime: "PT2M",
    step: recorderHowTo.map((s, i) => ({
      "@type": "HowToStep", position: i + 1, name: s.name, text: s.text, url: `${url}#step-${i + 1}`,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: v.faqs.map((f) => ({
      "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Base
  title={v.title}
  description={v.description}
  headerCta={{ label: "All tools", href: "/tools/" }}
  headerLabel={v.name}
  headerLabelHref="/tools/voice-recorder/"
>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <!-- Hero and tool -->
  <section class="bg-secondary pt-5 pb-12 md:pt-7 md:pb-16">
    <div class="container-page flex flex-col items-center text-center">
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center justify-center gap-2 text-sm font-semibold text-tertiary">
        <a href="/tools/" class="hover:text-tertiary_hover">Tools</a>
        <span aria-hidden="true">/</span>
        <span class="text-brand-secondary">{v.name}</span>
      </nav>
      <h1 class="mt-4 max-w-4xl text-display-sm font-semibold text-primary md:text-display-md">{v.h1}</h1>
      <p class="mt-3 max-w-2xl text-md text-tertiary md:text-lg">{v.intro}</p>
      <div class="mt-5 flex flex-wrap items-center justify-center gap-2">
        <Badge variant="success" size="lg">Nothing uploaded</Badge>
        <Badge variant="secondary" size="lg">No sign-up</Badge>
        <Badge variant="secondary" size="lg">MP3 and WAV</Badge>
      </div>
    </div>

    <div class="mt-6 md:mt-8"><VoiceRecorder /></div>

    <div class="container-page mt-10 max-w-5xl md:mt-12"><AdSlot placement="below-results" /></div>
  </section>

  <!-- Short answer -->
  <section class="bg-secondary pb-14 md:pb-20">
    <div class="container-page">
      <div class="mx-auto max-w-3xl rounded-3xl bg-primary p-6 shadow-xs ring-1 ring-secondary md:p-8" data-reveal>
        <h2 class="text-display-xs font-semibold text-primary">The short answer</h2>
        <p class="mt-3 text-lg text-tertiary">{v.answer}</p>
      </div>

      <div class="mt-14 md:mt-20">
        <SectionHeader eyebrow="How to use it" title="Three steps to a finished file" />
        <ol class="mx-auto mt-10 grid max-w-5xl gap-6 md:mt-12 md:grid-cols-3">
          {recorderHowTo.map((s, i) => (
            <li class="flex flex-col rounded-3xl bg-primary p-6 shadow-xs ring-1 ring-secondary" data-reveal>
              <span class="grid size-11 place-items-center rounded-full text-md font-semibold text-neutral-900" style={`background:${v.tint}`} aria-hidden="true">{i + 1}</span>
              <h3 class="mt-5 text-lg font-semibold text-primary"><span class="sr-only">Step {i + 1}: </span>{s.name}</h3>
              <p class="mt-2 text-md text-tertiary">{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <div class="bg-secondary pb-14 md:pb-20">
    <div class="container-page max-w-4xl"><AdSlot placement="in-content" /></div>
  </div>

  <!-- Tips -->
  <section class="bg-secondary pb-14 md:pb-20">
    <div class="container-page">
      <SectionHeader eyebrow="Getting a clean take" title="Four things worth knowing" />
      <ul class="mx-auto mt-10 grid max-w-5xl gap-6 md:mt-12 md:grid-cols-2">
        {v.tips.map((t) => (
          <li class="flex gap-4 rounded-3xl bg-primary p-6 shadow-xs ring-1 ring-secondary" data-reveal>
            <span class="grid size-10 shrink-0 place-items-center rounded-full text-neutral-900" style={`background:${v.tint}`} aria-hidden="true">
              <Icon name="check" class="size-5" />
            </span>
            <div>
              <h3 class="text-lg font-semibold text-primary">{t.title}</h3>
              <p class="mt-1.5 text-md text-tertiary">{t.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Troubleshooting -->
  <section class="bg-secondary pb-14 md:pb-20">
    <div class="container-page">
      <SectionHeader eyebrow="Troubleshooting" title="If recording did not start" lede="Open the one that matches what the tool told you." />
      <div class="mx-auto mt-10 max-w-5xl md:mt-12" data-reveal><Troubleshoot /></div>
    </div>
  </section>

  <!-- Format guide: the citable reference -->
  <section class="bg-secondary pb-14 md:pb-20">
    <div class="container-page">
      <SectionHeader
        eyebrow="Which format"
        title="What to download, for what"
        lede="Pick by what you are going to do with the file rather than by the codec."
      />
      <div class="mx-auto mt-10 max-w-5xl overflow-x-auto rounded-3xl ring-1 ring-secondary md:mt-12" data-reveal>
        <table class="w-full min-w-[720px] border-collapse text-left">
          <caption class="sr-only">Audio formats compared by use, size and where they play</caption>
          <thead>
            <tr class="bg-primary">
              <th scope="col" class="px-4 py-4 text-sm font-semibold text-tertiary md:px-6">Format</th>
              <th scope="col" class="px-4 py-4 text-sm font-semibold text-tertiary md:px-6">Use it for</th>
              <th scope="col" class="px-4 py-4 text-sm font-semibold text-tertiary md:px-6">Size</th>
              <th scope="col" class="px-4 py-4 text-sm font-semibold text-tertiary md:px-6">Plays on</th>
              <th scope="col" class="px-4 py-4 text-sm font-semibold text-tertiary md:px-6">Quality</th>
            </tr>
          </thead>
          <tbody>
            {formatGuide.map((r) => (
              <tr class="border-t border-secondary bg-primary">
                <th scope="row" class="px-4 py-4 text-md font-semibold text-primary md:px-6">{r.format}</th>
                <td class="px-4 py-4 text-md text-tertiary md:px-6">{r.use}</td>
                <td class="px-4 py-4 text-md text-tertiary tabular-nums md:px-6">{r.size}</td>
                <td class="px-4 py-4 text-md text-tertiary md:px-6">{r.plays}</td>
                <td class="px-4 py-4 text-md text-tertiary md:px-6">{r.keep}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="mx-auto mt-10 max-w-5xl" data-reveal>
        <h3 class="text-lg font-semibold text-primary">If it is going somewhere that normalises loudness</h3>
        <p class="mt-2 text-md text-tertiary">
          Every major platform turns loud uploads down to a target, so mastering louder than the target gains nothing.
        </p>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {loudnessTargets.map((l) => (
            <li class="flex items-baseline justify-between gap-4 rounded-2xl bg-primary px-4 py-3 ring-1 ring-secondary">
              <span class="text-md font-semibold text-primary">{l.platform}</span>
              <span class="text-md tabular-nums text-brand-secondary">{l.target}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Privacy -->
  <section id="privacy" class="bg-secondary pb-14 md:pb-20">
    <div class="container-page">
      <div class="mx-auto grid max-w-5xl gap-8 rounded-3xl bg-brand-section px-6 py-10 md:grid-cols-2 md:px-10" data-reveal>
        <div>
          <h2 class="text-display-xs font-semibold text-primary_on-brand">Your voice stays on your device</h2>
          <p class="mt-3 text-md text-tertiary_on-brand">
            Most online recorders are honest about this now, so it is worth being precise about what it means here: there
            is no upload code in this page at all. The recording is captured, drawn, trimmed and encoded by your own
            browser, and the file is written straight to your downloads. The badge says <em>0 bytes of audio</em> rather
            than 0 bytes because, like most sites, this one counts visits — that analytics call carries no audio, and
            you can see for yourself in your browser's network tab that nothing else leaves while you record.
          </p>
        </div>
        <ul class="flex flex-col gap-3 self-center">
          {[
            "No upload, no server copy, no account",
            "Closing the tab discards the recording",
            "The MP3 encoder runs on your machine, not ours",
            "Ads never load or refresh while you are recording",
            "Site analytics count the visit, and never see the audio",
          ].map((x) => (
            <li class="flex gap-3 text-md text-primary_on-brand">
              <span class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-white/15"><Icon name="check" class="size-3.5" /></span>
              {x}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="bg-secondary pb-14 md:pb-20">
    <div class="container-page grid gap-10 lg:grid-cols-[1fr_2fr] lg:gap-16">
      <div>
        <SectionHeader align="left" eyebrow="FAQ" title="Questions people ask" lede="Anything we've missed?" />
        <div class="mt-6" data-reveal>
          <Button href="/contact/?topic=bug&app=voice-recorder" variant="outline" size="lg">Tell us</Button>
        </div>
      </div>
      <div data-reveal><Faq id="recorder-faq" items={v.faqs} /></div>
    </div>
  </section>

  <RelatedGuides tool="/tools/voice-recorder/" />

  <!-- Related -->
  <section class="bg-secondary pb-16 md:pb-24">
    <div class="container-page">
      <h2 class="text-display-xs font-semibold text-primary" data-reveal>Before you record</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((t) => (
          <li data-reveal>
            <a href={`/tools/${t.slug}/`} class="group flex h-full flex-col rounded-3xl bg-primary p-5 shadow-xs ring-1 ring-secondary transition hover:shadow-lg focus-visible:outline-2 focus-visible:outline-focus-ring">
              <span class="grid size-11 place-items-center rounded-2xl text-neutral-900" style={`background:${t.tint}`} aria-hidden="true">
                <Icon name={t.icon} class="size-5" />
              </span>
              <p class="mt-4 text-md font-semibold text-primary">{t.name}</p>
              <p class="mt-1 text-sm text-tertiary">{t.tagline}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
