---
import Base from "@/layouts/Base.astro";
import ContactForm from "@/components/ContactForm";
import { FeaturedIcon } from "@/components/foundations/featured-icon/featured-icon";
import { getIcon } from "@/lib/icons";
import { products } from "@/data/products";

const apps = products.map((p) => ({ slug: p.slug, name: p.name }));
const notes = [
  { icon: "clock", title: "Replies", body: "Usually within two working days." },
  { icon: "camera", title: "Bugs", body: "A screenshot and your phone model help us fix it faster." },
  { icon: "pen", title: "Design projects", body: "Tell us what you're building, your timeline and your budget." },
];
---

<Base title="Contact and feedback — Spolvero" description="Send feedback on a Spolvero app, report a bug, or tell us about a design project." headerCta={{ label: "Our apps", href: "/#apps" }}>
  <section class="bg-primary py-16 md:py-24">
    <div class="container-page grid gap-16 lg:grid-cols-2">
      <div>
        <span class="text-sm font-semibold text-brand-secondary md:text-md">Contact us</span>
        <h1 class="mt-3 text-display-md font-semibold text-primary md:text-display-lg">Get in touch</h1>
        <p class="mt-4 text-lg text-tertiary md:mt-6 md:text-xl">Feedback on an app, a bug, or a project you'd like designed. We read every message.</p>
        <ul class="mt-12 flex flex-col gap-8">
          {notes.map((n) => (
            <li class="flex gap-4">
              <FeaturedIcon icon={getIcon(n.icon)} size="lg" color="brand" theme="modern" />
              <div>
                <h2 class="text-lg font-semibold text-primary">{n.title}</h2>
                <p class="mt-1 text-md text-tertiary">{n.body}</p>
              </div>
            </li>
          ))}
          <li class="flex gap-4">
            <FeaturedIcon icon={getIcon("mail")} size="lg" color="brand" theme="modern" />
            <div>
              <h2 class="text-lg font-semibold text-primary">Email instead</h2>
              <a class="mt-1 block text-md font-semibold text-brand-secondary hover:underline" href="mailto:spolvero.design@gmail.com">spolvero.design@gmail.com</a>
            </div>
          </li>
        </ul>
      </div>
      <div class="rounded-3xl bg-primary p-6 shadow-lg ring-1 ring-secondary md:p-8">
        <ContactForm client:load apps={apps} />
      </div>
    </div>
  </section>
</Base>
