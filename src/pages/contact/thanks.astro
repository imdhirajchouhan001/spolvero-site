---
import Base from "@/layouts/Base.astro";
import { Button } from "@/components/base/buttons/button";
import { FeaturedIcon } from "@/components/foundations/featured-icon/featured-icon";
import { BackgroundPattern } from "@/components/shared-assets/background-patterns";
import { getIcon } from "@/lib/icons";
---

<Base title="Message sent — Spolvero" description="Thanks for getting in touch." noindex>
  <section class="relative overflow-hidden bg-primary py-24 md:py-32">
    <BackgroundPattern pattern="circle" size="lg" className="absolute top-0 left-1/2 -translate-x-1/2 text-border-secondary opacity-70" />
    <div class="relative container-page flex flex-col items-center text-center">
      <FeaturedIcon icon={getIcon("checkCircle")} size="xl" color="success" theme="modern" />
      <h1 class="mt-6 max-w-2xl text-display-sm font-semibold text-primary md:text-display-md" data-title>Message sent. Thanks for writing.</h1>
      <p class="mt-4 max-w-lg text-lg text-tertiary md:text-xl" data-lede>We'll reply to the email you gave, usually within two working days.</p>
      <div class="mt-8 flex flex-col-reverse gap-3 sm:flex-row">
        <Button href="/#apps" color="secondary" size="xl">See our apps</Button>
        <Button href="/" color="primary" size="xl">Back to home</Button>
      </div>
    </div>
  </section>
</Base>

<script>
  if (new URLSearchParams(location.search).get("from") === "updates") {
    document.querySelector("[data-title]")!.textContent = "You're on the launch list.";
    document.querySelector("[data-lede]")!.textContent = "We'll email you when something new ships. Nothing else.";
  }
</script>
