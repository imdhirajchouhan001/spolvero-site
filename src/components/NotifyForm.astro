---
interface Props {
  product?: string;
  class?: string;
  onBrand?: boolean;
}
const { product, class: className, onBrand = false } = Astro.props;
const list = product ? `${product} launch` : "Spolvero launches";
const id = `notify-${(product ?? "all").toLowerCase().replace(/\W+/g, "-")}`;
---

<form action="https://formsubmit.co/spolvero.design@gmail.com" method="POST" class:list={["w-full", className]}>
  <div class="flex flex-col gap-3 sm:flex-row">
    <div class="flex-1">
      <label class="sr-only" for={id}>Email address</label>
      <input
        id={id}
        type="email"
        name="email"
        required
        autocomplete="email"
        placeholder="Enter your email"
        class="w-full rounded-lg bg-primary px-3.5 py-3 text-md text-primary shadow-xs ring-1 ring-primary outline-hidden ring-inset placeholder:text-placeholder focus:ring-2 focus:ring-brand"
      />
      <p class:list={["mt-1.5 text-left text-sm", onBrand ? "text-tertiary_on-brand" : "text-tertiary"]}>One email per launch, nothing else. <a href="/privacy/" class="underline">Privacy</a></p>
    </div>
    <button
      type="submit"
      class:list={[
        "relative h-12 shrink-0 rounded-lg px-5 text-md font-semibold shadow-xs-skeuomorphic transition",
        onBrand ? "bg-primary text-secondary ring-1 ring-primary ring-inset hover:bg-primary_hover" : "bg-brand-solid text-white hover:bg-brand-solid_hover",
      ]}
    >
      {product ? "Notify me" : "Subscribe"}
    </button>
  </div>
  <input type="hidden" name="_subject" value={`Launch list: ${list}`} />
  <input type="hidden" name="list" value={list} />
  <input type="hidden" name="_next" value="https://spolvero.design/contact/thanks/?from=updates" />
  <input type="hidden" name="_template" value="table" />
  <input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" class="absolute -left-[9999px]" />
</form>
