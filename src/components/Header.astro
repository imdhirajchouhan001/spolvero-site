---
// The header stays deliberately quiet.
//
// Every page here is meant to win on its own — a teacher looking for a classroom
// timer should land on a page about classroom timers, not on one advertising a
// catalogue. So the header carries the logo, the name of whatever you are
// currently looking at, and that page's own call to action. Everything else lives
// behind one menu that drops down over the page when asked for.
import Icon from "@/components/Icon.astro";
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import { navGroups, navLinks } from "@/data/nav";

interface Props {
  cta?: { label: string; href: string };
  /** The thing this page is about, shown beside the logo. */
  label?: string;
  labelHref?: string;
}
const { cta = { label: "Contact us", href: "/contact/" }, label, labelHref } = Astro.props;
---

<header class="sticky top-0 z-40 border-b border-transparent bg-secondary/85 backdrop-blur-lg transition-colors" data-header>
  <nav aria-label="Main" class="container-page flex h-18 items-center justify-between gap-4">
    <div class="flex min-w-0 items-center gap-3">
      <a href="/" aria-label="Spolvero home" class="shrink-0 text-brand-800">
        <span class="logo-mark w-[104px]"></span>
      </a>
      {label && (
        <>
          <span class="text-border-primary" aria-hidden="true">/</span>
          <a
            href={labelHref ?? "#"}
            class="truncate text-md font-semibold text-primary transition hover:text-brand-secondary"
          >{label}</a>
        </>
      )}
    </div>

    <div class="flex shrink-0 items-center gap-2">
      <div class="hidden sm:block">
        <Button href={cta.href} variant="default" size="md">{cta.label}</Button>
      </div>
      <button
        type="button"
        class="inline-flex h-10 items-center gap-2 rounded-sm border border-[var(--border)] px-3.5 text-sm font-semibold text-[var(--foreground)] transition hover:bg-[var(--muted)] focus-visible:ring-[3px] focus-visible:ring-[var(--ring)]/50 focus-visible:outline-none"
        data-menu-button
        aria-expanded="false"
        aria-controls="site-menu"
      >
        <Icon name="menu" class="size-5" />
        <span>Menu</span>
      </button>
    </div>
  </nav>

  <!-- Drops down over the page. Everything Spolvero makes, one level deep. -->
  <div
    id="site-menu"
    class="invisible fixed inset-x-0 top-18 z-40 max-h-[calc(100vh-4.5rem)] -translate-y-3 overflow-y-auto border-b border-secondary bg-secondary opacity-0 shadow-lg transition duration-200"
    data-menu-panel
  >
    <div class="container-page py-8 lg:py-10">
      <div class="grid gap-8 lg:grid-cols-3">
        {navGroups.map((g) => (
          <div>
            <div class="flex items-baseline justify-between gap-2 border-b border-secondary pb-3">
              <a href={g.href} class="text-md font-semibold text-primary hover:text-brand-secondary">{g.label}</a>
              <a href={g.footer?.href ?? g.href} class="text-sm font-semibold text-brand-secondary hover:underline">All</a>
            </div>
            <p class="mt-3 text-sm text-tertiary">{g.blurb}</p>

            {/* Categories, where a flat list would not survive the tool count */}
            {g.categories && (
              <div class="mt-4 flex flex-col gap-5">
                {g.categories.map((c) => (
                  <div>
                    <a href={c.href} class="flex items-baseline gap-2 text-sm font-semibold text-primary hover:text-brand-secondary">
                      {c.label}
                      <span class="text-xs font-normal text-quaternary">{c.count}</span>
                    </a>
                    <ul class="mt-1.5 flex flex-col">
                      {c.featured.map((it) => (
                        <li>
                          <a href={it.href} class="flex items-center justify-between gap-3 rounded-lg px-2 py-1.5 transition hover:bg-primary">
                            <span class="truncate text-md text-secondary">{it.label}</span>
                            {it.status === "soon" && <Badge variant="secondary" size="sm">Soon</Badge>}
                          </a>
                        </li>
                      ))}
                      {c.count > c.featured.length && (
                        <li>
                          <a href={c.href} class="block rounded-lg px-2 py-1.5 text-md font-semibold text-brand-secondary hover:underline">
                            {c.count - c.featured.length} more
                          </a>
                        </li>
                      )}
                    </ul>
                  </div>
                ))}
              </div>
            )}

            {/* A plain list, where the group is small enough to show whole */}
            {g.items && (
              <ul class="mt-3 flex flex-col">
                {g.items.map((it) => (
                  <li>
                    <a href={it.href} class="flex items-center justify-between gap-3 rounded-xl px-2 py-2.5 transition hover:bg-primary">
                      <span class="min-w-0">
                        <span class="block truncate text-md font-semibold text-primary">{it.label}</span>
                        {it.note && <span class="block truncate text-sm text-tertiary">{it.note}</span>}
                      </span>
                      {it.status === "live"
                        ? <Badge variant="success" size="sm">Live</Badge>
                        : <Badge variant="secondary" size="sm">Soon</Badge>}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>

      <ul class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-secondary pt-6">
        {navLinks.map((l) => (
          <li><a href={l.href} class="text-md font-semibold text-primary hover:text-brand-secondary">{l.label}</a></li>
        ))}
        <li class="sm:hidden"><a href={cta.href} class="text-md font-semibold text-brand-secondary">{cta.label}</a></li>
      </ul>
    </div>
  </div>

  <div class="invisible fixed inset-0 top-18 z-30 bg-neutral-950/30 opacity-0 transition duration-200" data-menu-backdrop></div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const onScroll = () => header?.classList.toggle("border-secondary", window.scrollY > 8);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const button = document.querySelector<HTMLButtonElement>("[data-menu-button]");
  const panel = document.querySelector<HTMLElement>("[data-menu-panel]");
  const backdrop = document.querySelector<HTMLElement>("[data-menu-backdrop]");

  if (button && panel && backdrop) {
    // Classes rather than a scoped stylesheet: Tailwind utilities on the element
    // would otherwise win the cascade over anything declared here.
    const shown = ["visible", "opacity-100", "translate-y-0"];
    const hidden = ["invisible", "opacity-0", "-translate-y-3"];

    const setOpen = (open: boolean) => {
      button.setAttribute("aria-expanded", String(open));
      panel.classList.toggle("invisible", !open);
      panel.classList.toggle("opacity-0", !open);
      panel.classList.toggle("-translate-y-3", !open);
      backdrop.classList.toggle("invisible", !open);
      backdrop.classList.toggle("opacity-0", !open);
      // Stop the page behind scrolling while the menu is over it.
      document.body.style.overflow = open ? "hidden" : "";
      if (open) panel.querySelector<HTMLAnchorElement>("a")?.focus();
    };

    button.addEventListener("click", () => setOpen(button.getAttribute("aria-expanded") !== "true"));
    backdrop.addEventListener("click", () => setOpen(false));
    panel.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && button.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        button.focus();
      }
    });

    // Focus leaving the panel closes it, so keyboard users are not trapped.
    panel.addEventListener("focusout", (e) => {
      if (!panel.contains(e.relatedTarget as Node) && e.relatedTarget !== button) setOpen(false);
    });
  }
</script>
