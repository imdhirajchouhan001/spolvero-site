---
// The webcam test itself. No framework, no dependencies: the page stays static
// and the tool is one small module script, so first load has nothing to hydrate.
//
// Camera handling (device enumeration after permission, constraint negotiation,
// getUserMedia error names, devicechange) follows the WebRTC project's samples,
// used under the BSD 3-Clause licence: https://github.com/webrtc/samples
//
// Nothing here uploads: the stream goes to a <video> and a <canvas>, both local.
import Icon from "@/components/Icon.astro";
import Button from "@/components/ui/Button.astro";
import { getIcon } from "@/lib/icons";

const checks = [
  { id: "working", label: "Camera working", hint: "Whether the browser can open your camera at all." },
  { id: "resolution", label: "Resolution", hint: "The size of the picture your camera is sending right now." },
  { id: "fps", label: "Frame rate", hint: "Frames per second, measured from the live stream." },
  { id: "lighting", label: "Lighting", hint: "How bright and how even the light on your face is." },
];
---

<section class="container-page" aria-labelledby="tool-heading">
  <div
    class="mx-auto max-w-5xl overflow-hidden rounded-3xl bg-primary shadow-lg ring-1 ring-secondary"
    data-webcam
    data-state="idle"
  >
    <h2 id="tool-heading" class="sr-only">Webcam test</h2>

    <div class="grid lg:grid-cols-[1.15fr_1fr]">
      <!-- Stage -->
      <div class="stage relative aspect-[4/3] bg-[#0c0c2a] lg:aspect-auto lg:min-h-[380px]">
        <video
          data-video
          class="absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-500 [transform:scaleX(-1)]"
          playsinline
          autoplay
          muted
        ></video>

        <!-- Idle -->
        <div class="absolute inset-0 grid place-items-center p-6 text-center" data-pane="idle">
          <div>
            <span class="mx-auto grid size-16 place-items-center rounded-full bg-white/10 text-white">
              <Icon name="camera" class="size-8" />
            </span>
            <p class="mt-5 text-lg font-semibold text-white">Your camera preview appears here</p>
            <p class="mx-auto mt-2 max-w-sm text-md text-white/70">
              Nothing is recorded and nothing is uploaded. The video stays in this browser tab.
            </p>
          </div>
        </div>

        <!-- Waiting for the browser prompt -->
        <div class="absolute inset-0 hidden place-items-center p-6 text-center" data-pane="prompting">
          <div>
            <span class="mx-auto grid size-16 animate-pulse place-items-center rounded-full bg-white/10 text-white">
              <Icon name="lock" class="size-8" />
            </span>
            <p class="mt-5 text-lg font-semibold text-white">Choose “Allow” in your browser</p>
            <p class="mx-auto mt-2 max-w-sm text-md text-white/70">
              The prompt usually appears at the top left of the window. On a phone it appears at the bottom.
            </p>
          </div>
        </div>

        <!-- Error -->
        <div class="absolute inset-0 hidden place-items-center p-6 text-center" data-pane="error">
          <div>
            <span class="mx-auto grid size-16 place-items-center rounded-full bg-error-solid/20 text-error-primary">
              <Icon name="close" class="size-8" />
            </span>
            <p class="mt-5 text-lg font-semibold text-white" data-error-title>Something blocked the camera</p>
            <p class="mx-auto mt-2 max-w-sm text-md text-white/70" data-error-body></p>
            <a class="mt-4 inline-flex text-md font-semibold text-white underline" href="#fix" data-error-link>Read the fix for this</a>
          </div>
        </div>

        <!-- Live badges -->
        <div class="pointer-events-none absolute inset-0 flex flex-col justify-between p-3 opacity-0 transition-opacity" data-live-chrome>
          <div class="flex items-start justify-between gap-2">
            <span class="inline-flex items-center gap-1.5 rounded-sm bg-black/55 px-2.5 py-1 text-xs font-semibold text-white backdrop-blur">
              <span class="size-1.5 rounded-full bg-error-solid"></span> Live preview
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-sm bg-black/55 px-2.5 py-1 text-xs font-semibold text-white backdrop-blur">
              <Icon name="shield" class="size-3.5" /> 0 bytes uploaded
            </span>
          </div>
          <div>
            <button
              type="button"
              data-mirror
              aria-pressed="true"
              class="pointer-events-auto inline-flex items-center gap-1.5 rounded-sm bg-black/55 px-2.5 py-1.5 text-xs font-semibold text-white backdrop-blur transition hover:bg-black/70 aria-pressed:ring-1 aria-pressed:ring-white/40"
            >
              <Icon name="split" class="size-3.5" /> Mirror
            </button>
          </div>
        </div>
      </div>

      <!-- Panel -->
      <div class="panel flex flex-col p-5 md:p-6">
        <div data-pane="start">
          <p class="text-sm font-semibold text-brand-secondary">Free · No sign-up</p>
          <p class="mt-2 text-xl font-semibold text-primary">Ready when you are</p>
          <p class="mt-2 text-md text-tertiary">
            One tap, one browser prompt, and you get a score with anything worth fixing.
          </p>
          <Button variant="default" size="xl" class="mt-6 w-full" data-start><Icon name="camera" />Test my camera</Button>
          <ul class="mt-6 flex flex-col gap-3">
            {["Works on Chrome, Safari, Firefox and Edge", "Front and rear cameras on phones", "Revoke access any time from the address bar"].map((x) => (
              <li class="flex gap-2.5 text-md text-tertiary">
                <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-success-secondary text-fg-success-primary"><Icon name="check" class="size-3" /></span>
                {x}
              </li>
            ))}
          </ul>
        </div>

        <!-- Results -->
        <div class="hidden" data-pane="results">
          <div class="flex items-center gap-4">
            <div class="relative size-20 shrink-0">
              <svg viewBox="0 0 120 120" class="size-full -rotate-90" aria-hidden="true">
                <circle cx="60" cy="60" r="52" fill="none" stroke="currentColor" stroke-width="10" class="text-secondary" />
                <circle
                  cx="60" cy="60" r="52" fill="none" stroke="currentColor" stroke-width="10" stroke-linecap="round"
                  class="text-brand-solid transition-[stroke-dashoffset] duration-1000 ease-out"
                  stroke-dasharray="326.7" stroke-dashoffset="326.7" data-ring
                />
              </svg>
              <span class="absolute inset-0 grid place-items-center text-display-xs font-semibold text-primary" data-score>–</span>
            </div>
            <div>
              <p class="text-sm font-semibold text-brand-secondary">Readiness score</p>
              <p class="mt-0.5 text-xl font-semibold text-primary" data-verdict>Measuring…</p>
              <p class="mt-1 text-sm text-tertiary" data-verdict-note></p>
            </div>
          </div>

          <ul class="mt-4 flex flex-col divide-y divide-secondary border-y border-secondary" role="list">
            {checks.map((c) => (
              <li class="flex flex-col gap-1 py-3" data-check={c.id}>
                <div class="flex items-center justify-between gap-3">
                  <span class="text-md font-semibold text-primary">{c.label}</span>
                  <span class="inline-flex items-center gap-1.5 rounded-sm bg-secondary px-2.5 py-0.5 text-sm font-semibold text-tertiary" data-pill>
                    Checking…
                  </span>
                </div>
                <p class="text-sm text-tertiary" data-tip>{c.hint}</p>
              </li>
            ))}
          </ul>

          <details class="mt-3 rounded-2xl bg-secondary px-4 py-2.5">
            <summary class="cursor-pointer text-sm font-semibold text-secondary">Technical details</summary>
            <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-sm" data-tech></dl>
          </details>

          <div class="mt-4 flex flex-wrap items-center gap-2">
            <label class="min-w-0 flex-1">
              <span class="sr-only">Camera</span>
              <select
                data-devices
                class="w-full rounded-lg bg-primary px-3 py-2 text-sm text-primary shadow-xs ring-1 ring-primary outline-focus-ring focus:ring-2 focus:ring-brand"
              ></select>
            </label>
            <Button variant="outline" size="sm" data-retest>Test again</Button>
            <Button variant="ghost" size="sm" data-stop>Stop</Button>
          </div>
        </div>

        <p class="mt-4 flex items-start gap-2 text-sm text-tertiary" data-privacy>
          <span class="mt-0.5 text-fg-success-primary"><Icon name="lock" class="size-4" /></span>
          <span>
            Nothing is uploaded or recorded — the video stays in this tab.
            <a class="font-semibold text-brand-secondary hover:underline" href="#privacy">How this works</a>
          </span>
        </p>
      </div>
    </div>

    <p class="sr-only" role="status" aria-live="polite" data-announce></p>
  </div>
</section>

<style>
  /* On a phone the idle preview is an empty box, so lead with the button instead;
     once the camera is live the preview moves back to the top. */
  @media (max-width: 1023px) {
    [data-webcam] .stage { order: 2; }
    [data-webcam] .panel { order: 1; }
    [data-webcam][data-state="live"] .stage { order: 1; }
    [data-webcam][data-state="live"] .panel { order: 2; }
  }
</style>

<script>
  type CheckId = "working" | "resolution" | "fps" | "lighting";
  type Tone = "good" | "warn" | "bad";

  const root = document.querySelector<HTMLElement>("[data-webcam]");
  if (root) init(root);

  function init(root: HTMLElement) {
    const video = root.querySelector<HTMLVideoElement>("[data-video]")!;
    const devices = root.querySelector<HTMLSelectElement>("[data-devices]")!;
    const mirror = root.querySelector<HTMLButtonElement>("[data-mirror]")!;
    const ring = root.querySelector<SVGCircleElement>("[data-ring]")!;
    const announce = root.querySelector<HTMLElement>("[data-announce]")!;
    const panes = {
      idle: root.querySelector<HTMLElement>('[data-pane="idle"]')!,
      prompting: root.querySelector<HTMLElement>('[data-pane="prompting"]')!,
      error: root.querySelector<HTMLElement>('[data-pane="error"]')!,
      start: root.querySelector<HTMLElement>('[data-pane="start"]')!,
      results: root.querySelector<HTMLElement>('[data-pane="results"]')!,
    };
    const chrome = root.querySelector<HTMLElement>("[data-live-chrome]")!;
    const canvas = document.createElement("canvas");
    canvas.width = 64;
    canvas.height = 48;
    const ctx = canvas.getContext("2d", { willReadFrequently: true });

    let stream: MediaStream | null = null;

    // ---- getUserMedia error names, mapped to the fix we publish for each ----
    const errors: Record<string, { id: string; title: string; body: string }> = {
      NotAllowedError: { id: "denied", title: "The browser blocked the camera", body: "Permission was refused or dismissed. It has to be reset from the address bar — the page cannot ask again on its own." },
      PermissionDeniedError: { id: "denied", title: "The browser blocked the camera", body: "Permission was refused or dismissed. It has to be reset from the address bar — the page cannot ask again on its own." },
      NotFoundError: { id: "notfound", title: "No camera was found", body: "The browser cannot see any camera. Check a lens cover, a privacy switch, or the cable on a USB camera." },
      DevicesNotFoundError: { id: "notfound", title: "No camera was found", body: "The browser cannot see any camera. Check a lens cover, a privacy switch, or the cable on a USB camera." },
      OverconstrainedError: { id: "notfound", title: "That camera could not start", body: "The selected camera cannot deliver a usable stream. Try another camera in the list." },
      NotReadableError: { id: "inuse", title: "The camera is in use by another app", body: "Something else is holding the camera. Fully quit Zoom, Teams, Meet tabs, Slack or OBS, then try again." },
      TrackStartError: { id: "inuse", title: "The camera is in use by another app", body: "Something else is holding the camera. Fully quit Zoom, Teams, Meet tabs, Slack or OBS, then try again." },
      SecurityError: { id: "denied", title: "This page is not allowed to use the camera", body: "Browsers only give camera access to secure pages. Check the address bar shows https and a padlock." },
    };

    // ---- state ----
    const setState = (s: "idle" | "prompting" | "live" | "error") => {
      root.dataset.state = s;
      panes.idle.style.display = s === "idle" ? "grid" : "none";
      panes.prompting.style.display = s === "prompting" ? "grid" : "none";
      panes.error.style.display = s === "error" ? "grid" : "none";
      panes.start.classList.toggle("hidden", s === "live");
      panes.results.classList.toggle("hidden", s !== "live");
      video.style.opacity = s === "live" ? "1" : "0";
      chrome.style.opacity = s === "live" ? "1" : "0";
    };

    const say = (msg: string) => { announce.textContent = msg; };

    const showError = (err: unknown) => {
      const name = (err as DOMException)?.name || "UnknownError";
      const e = errors[name] ?? {
        id: "black",
        title: "The camera did not start",
        body: "The browser reported: " + name + ". Restart the browser and try again.",
      };
      root.querySelector<HTMLElement>("[data-error-title]")!.textContent = e.title;
      root.querySelector<HTMLElement>("[data-error-body]")!.textContent = e.body;
      root.querySelector<HTMLAnchorElement>("[data-error-link]")!.href = "#fix-" + e.id;
      setState("error");
      say(e.title + ". " + e.body);
      // Open the matching troubleshooting section so the fix is one scroll away.
      const target = document.querySelector<HTMLButtonElement>(`[data-fix-toggle="${e.id}"]`);
      if (target && target.getAttribute("aria-expanded") === "false") target.click();
    };

    // ---- checks ----
    const setCheck = (id: CheckId, tone: Tone, pill: string, tip: string) => {
      const row = root.querySelector<HTMLElement>(`[data-check="${id}"]`);
      if (!row) return;
      const el = row.querySelector<HTMLElement>("[data-pill]")!;
      el.textContent = pill;
      el.className =
        "inline-flex items-center gap-1.5 rounded-sm px-2.5 py-0.5 text-sm font-semibold " +
        (tone === "good"
          ? "bg-success-secondary text-fg-success-primary"
          : tone === "warn"
            ? "bg-warning-secondary text-fg-warning-primary"
            : "bg-error-secondary text-fg-error-primary");
      const tipEl = row.querySelector<HTMLElement>("[data-tip]")!;
      tipEl.textContent = tip;
      // A green row is self-explanatory; only the rows worth acting on keep their text,
      // which keeps the whole result readable without scrolling.
      tipEl.hidden = tone === "good";
    };

    /** Counts the frames the browser actually delivers, so a throttled camera
     *  or a busy CPU shows up in the number — which is what a call would see.
     *  The first `warmUp` milliseconds are discarded: a stream that has just
     *  started is still ramping up, and counting that stall halves the result. */
    const measureFps = (ms = 1400, warmUp = 400): Promise<number> =>
      new Promise((resolve) => {
        const rvfc = (video as any).requestVideoFrameCallback?.bind(video);
        let t0 = 0;
        let counting = false;
        let frames = 0;

        const sample = (next: () => void) => {
          const now = performance.now();
          if (!t0) t0 = now;
          if (!counting) {
            // Still warming up: hold the clock, count nothing.
            if (now - t0 < warmUp) return next();
            counting = true;
            t0 = now;
            frames = 0;
            return next();
          }
          frames++;
          if (now - t0 < ms) return next();
          resolve(frames ? Math.round(frames / ((now - t0) / 1000)) : 0);
        };

        if (rvfc) {
          const tick = () => sample(() => rvfc(tick));
          rvfc(tick);
          return;
        }
        // Safari without rVFC: count distinct currentTime values instead.
        let last = -1;
        const tick = () => {
          if (video.currentTime === last) return requestAnimationFrame(tick);
          last = video.currentTime;
          sample(() => requestAnimationFrame(tick));
        };
        requestAnimationFrame(tick);
      });

    /** Mean luma of the frame, plus centre-versus-edge luma to catch a backlit shot. */
    const readLight = () => {
      if (!ctx || !video.videoWidth) return null;
      ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
      const { data } = ctx.getImageData(0, 0, canvas.width, canvas.height);
      let total = 0, centre = 0, centreN = 0, edge = 0, edgeN = 0;
      for (let y = 0; y < canvas.height; y++) {
        for (let x = 0; x < canvas.width; x++) {
          const i = (y * canvas.width + x) * 4;
          const luma = 0.2126 * data[i] + 0.7152 * data[i + 1] + 0.0722 * data[i + 2];
          total += luma;
          const inCentre = x > canvas.width * 0.3 && x < canvas.width * 0.7 && y > canvas.height * 0.2 && y < canvas.height * 0.8;
          if (inCentre) { centre += luma; centreN++; } else { edge += luma; edgeN++; }
        }
      }
      return {
        mean: total / (canvas.width * canvas.height),
        centre: centre / Math.max(centreN, 1),
        edge: edge / Math.max(edgeN, 1),
      };
    };

    const scoreBand = (n: number) =>
      n >= 85 ? "Great for any call" : n >= 65 ? "Fine for most calls" : n >= 45 ? "Usable, worth fixing" : "Needs attention";

    async function runChecks() {
      const track = stream?.getVideoTracks()[0];
      if (!track) return;
      const s = track.getSettings();
      let points = 10;

      setCheck("working", "good", "Working", `Your browser is receiving video from ${track.label || "your camera"}.`);

      // Resolution — the live video element is the truth, settings are the fallback.
      const w = video.videoWidth || s.width || 0;
      const h = video.videoHeight || s.height || 0;
      const ratio = w && h ? (Math.abs(w / h - 16 / 9) < 0.06 ? "16:9" : Math.abs(w / h - 4 / 3) < 0.06 ? "4:3" : `${w}:${h}`) : "—";
      if (h >= 1080) { points += 35; setCheck("resolution", "good", `${w}×${h}`, "Full HD. More than any mainstream call will send."); }
      else if (h >= 720) { points += 30; setCheck("resolution", "good", `${w}×${h}`, "HD. This is what Zoom, Teams and Meet send at their best."); }
      else if (h >= 480) { points += 18; setCheck("resolution", "warn", `${w}×${h}`, "Below HD. Usable, but you will look soft on a large screen. More light often pushes a camera back up to 720p."); }
      else if (h >= 360) { points += 10; setCheck("resolution", "warn", `${w}×${h}`, "This is the minimum most call apps accept. Check no other app is sharing the camera, and add light."); }
      else { setCheck("resolution", "bad", w ? `${w}×${h}` : "Unknown", "Too low for a video call. Try another camera in the list below."); }

      // Frame rate — measured, not advertised.
      say("Measuring frame rate");
      // Some cameras hand over a track that never presents a frame. Cap the wait so the
      // result always completes; the track's own reported rate is the fallback.
      const measured = await Promise.race([
        measureFps(),
        new Promise<number>((r) => setTimeout(() => r(0), 3000)),
      ]);
      // A browser that never presented a frame tells us nothing; use what the track reports.
      const fps = measured || Math.round(s.frameRate ?? 0);
      if (fps >= 50) { points += 25; setCheck("fps", "good", `${fps} fps`, "High frame rate. Useful for streaming; calls will not use all of it."); }
      else if (fps >= 25) { points += 23; setCheck("fps", "good", `${fps} fps`, "The standard for video calls. Motion will look smooth."); }
      else if (fps >= 20) { points += 15; setCheck("fps", "warn", `${fps} fps`, "Slightly below the 30fps standard. Close other apps and add light — cameras drop frames to stay bright."); }
      else if (fps >= 12) { points += 9; setCheck("fps", "warn", `${fps} fps`, "Low enough to look jerky. Low light is the usual cause, a busy CPU the next."); }
      else { setCheck("fps", "bad", `${fps} fps`, "Very low. Close other apps using the camera, then test again in brighter light."); }

      // Lighting.
      const light = readLight();
      if (!light) {
        setCheck("lighting", "warn", "Not measured", "The frame could not be sampled in this browser.");
      } else if (light.mean < 35) {
        points += 2;
        setCheck("lighting", "bad", "Very dark", "Almost no light is reaching the sensor. Check the lens cover, then put a lamp or window in front of you.");
      } else if (light.edge - light.centre > 40 && light.centre < 110) {
        points += 8;
        setCheck("lighting", "bad", "Backlit", "The background is much brighter than you are, so you read as a silhouette. Move the bright window or lamp so it is in front of you, not behind.");
      } else if (light.mean < 65) {
        points += 12;
        setCheck("lighting", "warn", "Too dark", "You are underlit. A desk lamp facing you fixes this faster than any camera setting, and usually raises resolution and frame rate too.");
      } else if (light.mean > 205) {
        points += 16;
        setCheck("lighting", "warn", "Overexposed", "The picture is blown out. Move away from the direct light or turn one source down.");
      } else {
        points += 30;
        setCheck("lighting", "good", "Good", "Even, sufficient light on your face. Nothing to fix here.");
      }

      const score = Math.max(0, Math.min(100, points));
      root.querySelector<HTMLElement>("[data-score]")!.textContent = String(score);
      ring.style.strokeDashoffset = String(326.7 - (326.7 * score) / 100);
      root.querySelector<HTMLElement>("[data-verdict]")!.textContent = scoreBand(score);
      root.querySelector<HTMLElement>("[data-verdict-note]")!.textContent =
        score >= 65 ? "You are ready to join a call." : "Fix the amber and red rows below, then test again.";

      const tech = root.querySelector<HTMLElement>("[data-tech]")!;
      const rows: [string, string][] = [
        ["Camera", track.label || "Unnamed camera"],
        ["Resolution", w ? `${w} × ${h}` : "—"],
        ["Aspect ratio", ratio],
        ["Measured frame rate", `${fps} fps`],
        ["Reported frame rate", s.frameRate ? `${Math.round(s.frameRate)} fps` : "not reported"],
        ["Mean brightness", light ? `${Math.round((light.mean / 255) * 100)}%` : "—"],
      ];
      tech.innerHTML = rows
        .map(([k, v]) => `<dt class="text-tertiary">${k}</dt><dd class="font-medium text-primary">${v}</dd>`)
        .join("");

      say(`Score ${score} out of 100. ${scoreBand(score)}.`);
      // Tells anything below the panel (such as the ad slot) that a verdict now exists.
      document.dispatchEvent(new CustomEvent("spolvero:result", { detail: { score } }));
    }

    // ---- camera ----
    async function listDevices() {
      try {
        const all = await navigator.mediaDevices.enumerateDevices();
        const cams = all.filter((d) => d.kind === "videoinput");
        const current = stream?.getVideoTracks()[0]?.getSettings().deviceId;
        devices.innerHTML = cams
          .map((d, i) => `<option value="${d.deviceId}"${d.deviceId === current ? " selected" : ""}>${d.label || `Camera ${i + 1}`}</option>`)
          .join("");
        devices.closest("label")!.style.display = cams.length > 1 ? "" : "none";
      } catch { /* enumeration is a nicety; the test still works without it */ }
    }

    function stop() {
      stream?.getTracks().forEach((t) => t.stop());
      stream = null;
      video.srcObject = null;
    }

    async function start(deviceId?: string) {
      if (!navigator.mediaDevices?.getUserMedia) {
        showError({ name: "SecurityError" });
        return;
      }
      stop();
      setState("prompting");
      // Ask for the best the camera will give; every browser narrows this down itself.
      const constraints: MediaStreamConstraints = {
        audio: false,
        video: deviceId
          ? { deviceId: { exact: deviceId } }
          : { width: { ideal: 1920 }, height: { ideal: 1080 }, frameRate: { ideal: 60 } },
      };
      try {
        stream = await navigator.mediaDevices.getUserMedia(constraints);
      } catch (err) {
        // A camera that cannot meet the ideal size still deserves a chance.
        if ((err as DOMException)?.name === "OverconstrainedError") {
          try { stream = await navigator.mediaDevices.getUserMedia({ audio: false, video: true }); }
          catch (err2) { showError(err2); return; }
        } else { showError(err); return; }
      }
      video.srcObject = stream;
      try { await video.play(); } catch { /* autoplay of a muted local stream is allowed; ignore races */ }
      setState("live");
      say("Camera is on. Measuring.");
      await listDevices();
      // Wait for real dimensions before measuring anything.
      if (!video.videoWidth) await new Promise((r) => video.addEventListener("loadedmetadata", r, { once: true }));
      runChecks();
    }

    // ---- wiring ----
    root.querySelector<HTMLElement>("[data-start]")?.addEventListener("click", () => start());
    root.querySelector<HTMLElement>("[data-retest]")?.addEventListener("click", () => start(devices.value || undefined));
    root.querySelector<HTMLElement>("[data-stop]")?.addEventListener("click", () => { stop(); setState("idle"); say("Camera stopped."); });
    devices.addEventListener("change", () => start(devices.value));
    mirror.addEventListener("click", () => {
      const on = mirror.getAttribute("aria-pressed") !== "true";
      mirror.setAttribute("aria-pressed", String(on));
      video.style.transform = on ? "scaleX(-1)" : "none";
    });
    navigator.mediaDevices?.addEventListener?.("devicechange", () => { if (stream) listDevices(); });
    // Never leave the camera running behind a closed tab.
    window.addEventListener("pagehide", stop);

    setState("idle");
  }
</script>
