---
import Base from "@/layouts/Base.astro";
import AppIcon from "@/components/AppIcon.astro";
import Icon from "@/components/Icon.astro";
import Screen from "@/components/Screen.astro";
import NotifyForm from "@/components/NotifyForm.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import AdSlot from "@/components/AdSlot.astro";
import Faq from "@/components/Faq.astro";
import SplitText from "@/components/SplitText";
import { Button } from "@/components/base/buttons/button";
import { GooglePlayButton } from "@/components/base/buttons/app-store-buttons";
import { Badge } from "@/components/base/badges/badges";
import { BadgeGroup } from "@/components/base/badges/badge-groups";
import { FeaturedIcon } from "@/components/foundations/featured-icon/featured-icon";
import { BackgroundPattern } from "@/components/shared-assets/background-patterns";
import { getIcon } from "@/lib/icons";
import { products, categories, getProduct } from "@/data/products";

const live = products.filter((p) => p.status === "live");
// Centre of the fan sits in the middle; every product here needs at least one screenshot.
const fan = [
  { p: getProduct("enough")!, i: 0 },
  { p: getProduct("unspend")!, i: 0 },
  { p: getProduct("exact")!, i: 0 },
];
const fanCentre = (fan.length - 1) / 2;
const [featured, ...rest] = products;

const principles = [
  { icon: "lock", title: "Private by default", body: "Your data stays on your phone. No bank logins, no gallery access, no account needed to start." },
  { icon: "eyeoff", title: "Ads that know their place", body: "Free apps may show ads, but nothing you type or track in our apps is ever shared with an ad network." },
  { icon: "quote", title: "Numbers you can check", body: "Every figure shows where it came from, and our apps say plainly what they can't prove." },
];

// Every "Spolvero way" line must stay true for all apps in src/data/products.ts.
const comparison = [
  { old: "Asks for your bank login, whole photo gallery or an account first", ours: "Asks only for what the job needs, and you can start without an account" },
  { old: "Sends what you enter to its own servers", ours: "Keeps what you enter on your phone by default" },
  { old: "Uses what you do in the app to target ads", ours: "Ads never see what you put into the app" },
  { old: "Gives you numbers with no explanation", ours: "Shows where its numbers come from" },
  { old: "Puts the main feature behind a paywall", ours: "The main job is free; upgrades are optional" },
];

const steps = [
  { title: "Discover", body: "A call about your product, users and goals. You get a written scope and quote before any work starts." },
  { title: "Design", body: "Flows, screens and a clickable prototype, reviewed with you as we go, plus a design system to keep it consistent." },
  { title: "Hand off and launch", body: "Developer-ready Figma files and assets, plus store screenshots and listing copy if you need them." },
];

const studioFaqs = [
  { q: "How much does a project cost?", a: "We charge $20–30 an hour depending on scope. You get a written quote with an estimate of hours before anything starts, so there are no surprises." },
  { q: "How long does a project take?", a: "It depends on the size of the product. We agree a timeline in the quote and keep you updated as we go." },
  { q: "What do I get at the end?", a: "Figma files with every screen and state, a clickable prototype, a component library or design system, and exported assets ready for your developers." },
  { q: "Who owns the designs?", a: "You do. Once the project is paid, the final designs are yours to use however you like." },
  { q: "Will you sign an NDA?", a: "Yes. Send it over with your first message and we'll sign it before you share any details." },
  { q: "Do you work with clients outside India?", a: "Yes. We work with founders and teams anywhere in the world, over email and video calls." },
  { q: "Can you also design my website or brand?", a: "Yes. Along with app design we do landing pages, product websites, and naming, logo, colour and type." },
];

const services = [
  "UI and UX for iOS and Android apps",
  "Flows, prototypes and design systems",
  "Landing pages and product websites",
  "Name, logo, colour and type",
  "Store listings and screenshots",
];
---

<Base
  title="Spolvero — a studio for small, useful apps"
  description="Spolvero designs and builds apps, games, web tools and software, and takes on UI/UX and branding projects for others."
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-primary pt-16 md:pt-24">
    <BackgroundPattern pattern="grid" size="lg" className="absolute top-0 left-1/2 hidden -translate-x-1/2 text-border-secondary opacity-70 md:block" />
    <BackgroundPattern pattern="grid" size="md" className="absolute top-0 left-1/2 -translate-x-1/2 text-border-secondary opacity-70 md:hidden" />

    <div class="relative container-page flex flex-col items-center text-center">
      <a href="#apps" class="rounded-full outline-focus-ring focus-visible:outline-2 focus-visible:outline-offset-2" data-reveal>
        <BadgeGroup addonText={`${products.length} apps`} color="brand" theme="modern" size="lg" iconTrailing={getIcon("arrow")}>
          {`${live.length} live on Google Play, more on the way`}
        </BadgeGroup>
      </a>

      <SplitText
        client:load
        tag="h1"
        text="Small apps, carefully made."
        splitType="words, chars"
        delay={24}
        duration={0.9}
        from={{ opacity: 0, y: 32 }}
        to={{ opacity: 1, y: 0 }}
        rootMargin="0px"
        threshold={0}
        className="mt-6 max-w-4xl text-display-md font-semibold text-primary md:text-display-2xl"
      />

      <p class="mt-4 max-w-3xl text-lg text-tertiary md:mt-6 md:text-xl" data-reveal>
        Spolvero is an independent studio. We design and build apps, games, web tools and software, and we design for other people too.
      </p>

      <div class="mt-8 flex w-full flex-col-reverse items-stretch gap-3 sm:w-auto sm:flex-row sm:items-start md:mt-12" data-reveal>
        <Button href="/contact/?topic=design" color="secondary" size="xl" iconLeading={getIcon("pen")}>Hire us for design</Button>
        <Button href="#apps" color="primary" size="xl">See our apps</Button>
      </div>

      <div class="relative mt-16 h-[380px] w-full max-w-5xl md:mt-20 md:h-[520px]" data-fan aria-label="Screens from Spolvero apps">
        {fan.map(({ p, i }, idx) => (
          <div
            class="absolute bottom-0 left-1/2 w-[160px] origin-bottom md:w-[240px]"
            data-fan-item={idx - fanCentre}
            style={`z-index:${10 - Math.abs(idx - fanCentre)};transform:translateX(-50%)`}
          >
            <Screen product={p} shot={p.screenshots[i]} />
          </div>
        ))}
      </div>
    </div>
    <div class="relative h-px bg-border-secondary"></div>
  </section>

  <!-- Principles -->
  <section class="bg-primary py-16 md:py-24">
    <div class="container-page">
      <SectionHeader eyebrow="How we build" title="Three promises in every app" lede="Whatever the app does, it's built the same way." />
      <ul class="mt-12 grid gap-10 md:mt-16 md:grid-cols-3 md:gap-8">
        {principles.map((x) => (
          <li class="flex flex-col items-center text-center" data-reveal>
            <FeaturedIcon icon={getIcon(x.icon)} size="lg" color="brand" theme="light" />
            <h3 class="mt-4 text-lg font-semibold text-primary md:mt-5 md:text-xl">{x.title}</h3>
            <p class="mt-1 text-md text-tertiary md:mt-2">{x.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Old way vs Spolvero way -->
  <section class="bg-primary pb-16 md:pb-24">
    <div class="container-page">
      <SectionHeader eyebrow="Why Spolvero" title="Apps shouldn't cost you your privacy" lede="Many everyday apps ask for too much and explain too little. We build ours the other way round." />
      <div class="mx-auto mt-12 max-w-5xl overflow-hidden rounded-3xl ring-1 ring-secondary md:mt-16" data-reveal>
        <table class="w-full border-collapse text-left">
          <caption class="sr-only">How typical apps compare with Spolvero apps</caption>
          <thead>
            <tr class="bg-secondary">
              <th scope="col" class="w-1/2 px-4 py-4 text-sm font-semibold text-tertiary md:px-6">Many apps</th>
              <th scope="col" class="w-1/2 bg-brand-section px-4 py-4 text-sm font-semibold text-primary_on-brand md:px-6">Spolvero apps</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map((row) => (
              <tr class="border-t border-secondary">
                <td class="px-4 py-5 align-top md:px-6">
                  <span class="flex gap-3 text-md text-tertiary">
                    <span class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-error-secondary text-fg-error-primary"><Icon name="close" class="size-3.5" /></span>
                    {row.old}
                  </span>
                </td>
                <td class="bg-brand-primary px-4 py-5 align-top md:px-6">
                  <span class="flex gap-3 text-md font-medium text-primary">
                    <span class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-success-secondary text-fg-success-primary"><Icon name="check" class="size-3.5" /></span>
                    {row.ours}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="mt-10 flex justify-center" data-reveal>
        <Button href="#apps" color="primary" size="xl" iconTrailing={getIcon("arrow")}>See our apps</Button>
      </div>
    </div>
  </section>

  <!-- Apps -->
  <section id="apps" class="bg-secondary py-16 md:py-24">
    <div class="container-page">
      <SectionHeader eyebrow="Our apps" title="Each one does one job well" lede="Tap any app to see how it works." />

      <!-- Featured (live) app -->
      <div class="mt-12 grid overflow-hidden rounded-3xl bg-primary shadow-xs ring-1 ring-secondary md:mt-16 lg:grid-cols-2" data-reveal>
        <div class="flex flex-col p-6 md:p-12">
          <div class="flex items-center gap-4">
            <AppIcon product={featured} size={56} />
            <div>
              <p class="text-xl font-semibold text-primary">{featured.name}</p>
              <p class="text-md text-tertiary">{featured.kind} · {featured.platform}</p>
            </div>
          </div>
          <div class="mt-6"><Badge type="pill-color" color="success" size="md">Live on Google Play</Badge></div>
          <h3 class="mt-4 text-display-xs font-semibold text-primary md:text-display-sm">{featured.tagline}</h3>
          <p class="mt-4 text-lg text-tertiary">{featured.summary}</p>
          <ul class="mt-6 flex flex-col gap-4">
            {featured.promise.points.slice(0, 3).map((pt) => (
              <li class="flex gap-3">
                <FeaturedIcon icon={getIcon("check")} size="sm" color="success" theme="light" />
                <span class="pt-1 text-md text-tertiary">{pt}</span>
              </li>
            ))}
          </ul>
          <div class="mt-8 flex flex-wrap items-center gap-4 md:mt-auto md:pt-10">
            <GooglePlayButton href={featured.playUrl} size="lg" />
            <Button href={`/${featured.slug}/`} color="link-color" size="lg" iconTrailing={getIcon("arrow")}>Learn more</Button>
          </div>
        </div>
        <div class="relative flex min-h-[340px] justify-center gap-4 overflow-hidden bg-brand-primary px-6 pt-12 md:pt-16">
          <BackgroundPattern pattern="circle" size="md" className="absolute top-0 left-1/2 -translate-x-1/2 text-brand-200" />
          <Screen product={featured} shot={featured.screenshots[0]} class="relative w-[46%] max-w-[240px] self-start" />
          <Screen product={featured} shot={featured.screenshots[1]} class="relative mt-16 w-[46%] max-w-[240px] self-start" />
        </div>
      </div>

      <!-- Other apps -->
      <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {rest.map((p) => (
          <li data-reveal>
            <a href={`/${p.slug}/`} class="group flex h-full flex-col overflow-hidden rounded-3xl bg-primary shadow-xs ring-1 ring-secondary transition hover:shadow-lg focus-visible:outline-2 focus-visible:outline-focus-ring">
              <div class="flex flex-col gap-4 p-6">
                <div class="flex items-start justify-between gap-3">
                  <AppIcon product={p} size={48} />
                  <Badge type="pill-color" color="gray" size="sm">Coming soon</Badge>
                </div>
                <div>
                  <p class="text-lg font-semibold text-primary">{p.name}</p>
                  <p class="text-sm text-tertiary">{p.kind}</p>
                </div>
                <p class="text-md text-tertiary">{p.tagline}</p>
                <span class="inline-flex items-center gap-1.5 text-md font-semibold text-brand-secondary">
                  Learn more <Icon name="arrow" class="size-5 transition-transform group-hover:translate-x-0.5" />
                </span>
              </div>
              <div class="relative mt-auto flex h-52 justify-center overflow-hidden" style={`background:${p.tint}`}>
                {p.screenshots.length ? (
                  <Screen product={p} shot={p.screenshots[0]} class="absolute top-6 w-[52%] max-w-[190px] transition-transform duration-500 group-hover:-translate-y-2" />
                ) : (
                  <div class="absolute top-6 grid w-[52%] max-w-[190px] grid-cols-3 gap-1.5 rounded-t-3xl bg-[#1f1f24] p-3 pt-12 transition-transform duration-500 group-hover:-translate-y-2" aria-hidden="true">
                    <span class="absolute top-3 right-3 text-xl font-semibold text-white">₹1,180</span>
                    {["7", "8", "9", "4", "5", "6", "1", "2", "3", "5%", "18%", "40%"].map((k) => (
                      <span class:list={["grid h-8 place-items-center rounded-md text-xs font-medium text-white", !k.includes("%") && "bg-white/10"]} style={k.includes("%") ? `background:${p.accent}` : undefined}>{k}</span>
                    ))}
                  </div>
                )}
              </div>
            </a>
          </li>
        ))}
        <li data-reveal>
          <a href="/contact/?topic=design" class="group flex h-full flex-col justify-between rounded-3xl border-2 border-dashed border-primary bg-primary p-6 transition hover:border-brand">
            <FeaturedIcon icon={getIcon("sparkles")} size="lg" color="brand" theme="modern" />
            <div class="mt-10">
              <p class="text-xl font-semibold text-primary">Have an app idea?</p>
              <p class="mt-2 text-md text-tertiary">We design apps for other people too, from the first sketch to the store listing.</p>
              <span class="mt-5 inline-flex items-center gap-1.5 text-md font-semibold text-brand-secondary">
                Talk to us <Icon name="arrow" class="size-5 transition-transform group-hover:translate-x-0.5" />
              </span>
            </div>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <div class="bg-primary pt-16 md:pt-24">
    <div class="container-page max-w-4xl">
      <AdSlot placement="in-content" />
    </div>
  </div>

  <!-- On the drawing board -->
  <section id="next" class="bg-primary pt-16 pb-16 md:pt-20 md:pb-24">
    <div class="container-page">
      <SectionHeader eyebrow="Coming up" title="On the drawing board" lede="Beyond apps, this is what we're sketching next. Nothing to download yet." />
      <ul class="mt-12 grid gap-6 md:mt-16 md:grid-cols-3">
        {categories.map((c) => {
          const Card = "href" in c && c.href ? "a" : "div";
          return (
            <li data-reveal>
              <Card
                href={"href" in c ? c.href : undefined}
                class:list={["group flex h-full flex-col rounded-3xl bg-secondary p-6 md:p-8", "href" in c && c.href && "transition hover:bg-primary_hover focus-visible:outline-2 focus-visible:outline-focus-ring"]}
              >
                <div class="flex items-start justify-between">
                  <FeaturedIcon icon={getIcon(c.icon)} size="lg" color="brand" theme="modern" />
                  <Badge type="pill-color" color={"href" in c && c.href ? "success" : "brand"} size="sm">{"href" in c && c.href ? "Live now" : "In design"}</Badge>
                </div>
                <h3 class="mt-8 text-xl font-semibold text-primary">{c.title}</h3>
                <p class="mt-2 text-md text-tertiary">{c.body}</p>
                {"href" in c && c.href && (
                  <span class="mt-4 inline-flex items-center gap-1.5 text-md font-semibold text-brand-secondary">
                    Open the tools <Icon name="arrow" class="size-5 transition-transform group-hover:translate-x-0.5" />
                  </span>
                )}
              </Card>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- Studio -->
  <section id="studio" class="bg-secondary py-16 md:py-24">
    <div class="container-page grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <SectionHeader align="left" eyebrow="Design studio" title="The design behind our apps, for yours" lede="We work with founders and teams anywhere in the world, from the first sketch to a design system your developers can build from." />
        <ul class="mt-8 flex flex-col gap-4" data-reveal>
          {services.map((s) => (
            <li class="flex gap-3">
              <FeaturedIcon icon={getIcon("check")} size="sm" color="brand" theme="light" />
              <span class="pt-1 text-lg text-tertiary">{s}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="self-center rounded-3xl bg-primary p-6 shadow-lg ring-1 ring-secondary md:p-10" data-reveal>
        <div class="flex items-center justify-between gap-4">
          <p class="text-lg font-semibold text-brand-secondary">Hourly rate</p>
          <Badge type="pill-color" color="brand" size="md">Worldwide</Badge>
        </div>
        <p class="mt-4 text-display-lg font-semibold text-primary md:text-display-xl">$20–30<span class="text-xl font-medium text-tertiary md:text-display-xs"> / hour</span></p>
        <p class="mt-4 text-md text-tertiary">Depending on scope. You get a written quote before any work starts.</p>
        <div class="mt-8 border-t border-secondary pt-8">
          <ul class="flex flex-col gap-4">
            {[{ i: "phone", t: "App design" }, { i: "browser", t: "Websites" }, { i: "palette", t: "Branding" }].map((x) => (
              <li class="flex items-center gap-3 text-md font-semibold text-secondary">
                <FeaturedIcon icon={getIcon(x.i)} size="md" color="gray" theme="modern" /> {x.t}
              </li>
            ))}
          </ul>
        </div>
        <Button href="/contact/?topic=design" color="primary" size="xl" className="mt-8 w-full" iconTrailing={getIcon("arrow")}>Tell us about your project</Button>
      </div>
    </div>

    <!-- How we work -->
    <div class="container-page mt-20 md:mt-24">
      <SectionHeader eyebrow="How we work" title="From first call to launch in three steps" />
      <ol class="mt-12 grid gap-6 md:mt-16 md:grid-cols-3">
        {steps.map((s, i) => (
          <li class="relative flex flex-col rounded-3xl bg-primary p-6 shadow-xs ring-1 ring-secondary md:p-8" data-reveal>
            <span class="grid size-12 place-items-center rounded-full bg-brand-solid text-lg font-semibold text-white" aria-hidden="true">{i + 1}</span>
            <h3 class="mt-6 text-xl font-semibold text-primary"><span class="sr-only">Step {i + 1}: </span>{s.title}</h3>
            <p class="mt-2 text-md text-tertiary">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Studio FAQ -->
  <section id="studio-faq" class="bg-primary py-16 md:py-24">
    <div class="container-page grid gap-12 lg:grid-cols-[1fr_2fr] lg:gap-16">
      <div>
        <SectionHeader align="left" eyebrow="Design studio" title="Questions from clients" lede="Anything else about working with us?" />
        <div class="mt-6" data-reveal>
          <Button href="/contact/?topic=design" color="secondary" size="lg">Ask us directly</Button>
        </div>
      </div>
      <div data-reveal>
        <Faq id="studio-faq-list" items={studioFaqs} />
      </div>
    </div>
  </section>

  <!-- Newsletter CTA -->
  <section id="updates" class="bg-primary py-16 md:py-24">
    <div class="container-page">
      <div class="relative overflow-hidden rounded-3xl bg-brand-section px-6 py-10 md:px-16 md:py-16" data-reveal>
        <BackgroundPattern pattern="grid" size="md" className="absolute -top-10 right-0 text-brand-700 opacity-60" />
        <div class="relative grid gap-8 lg:grid-cols-2 lg:items-center">
          <div>
            <h2 class="text-display-xs font-semibold text-primary_on-brand md:text-display-sm">Hear when something new ships</h2>
            <p class="mt-3 text-lg text-tertiary_on-brand md:text-xl">Be first to try each new Spolvero app.</p>
          </div>
          <NotifyForm onBrand />
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const fan = document.querySelector<HTMLElement>("[data-fan]");
  const items = gsap.utils.toArray<HTMLElement>("[data-fan-item]");
  const place = (el: HTMLElement, spread = 1) => {
    const n = Number(el.dataset.fanItem);
    const wide = window.innerWidth >= 768;
    return {
      xPercent: -50 + n * (wide ? 78 : 62) * spread,
      y: Math.abs(n) * (wide ? 34 : 22),
      rotation: n * 6 * spread,
    };
  };

  const mm = gsap.matchMedia();
  mm.add("(prefers-reduced-motion: no-preference)", () => {
    items.forEach((el) => {
      gsap.fromTo(
        el,
        { xPercent: -50, y: 160, rotation: 0, opacity: 0 },
        { ...place(el), opacity: 1, duration: 1.3, ease: "expo.out", delay: 0.35 + Math.abs(Number(el.dataset.fanItem)) * 0.08 },
      );
    });
    if (fan) {
      gsap.timeline({ scrollTrigger: { trigger: fan, start: "top 60%", end: "bottom top", scrub: 0.6 } }).to(items, {
        y: (_i, el) => place(el as HTMLElement, 1.15).y - 30,
        rotation: (_i, el) => place(el as HTMLElement, 1.25).rotation,
        xPercent: (_i, el) => place(el as HTMLElement, 1.12).xPercent,
        ease: "none",
      });
    }
  });
  mm.add("(prefers-reduced-motion: reduce)", () => {
    items.forEach((el) => gsap.set(el, place(el)));
  });
</script>
