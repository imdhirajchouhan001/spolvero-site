---
import Base from "@/layouts/Base.astro";
import { Button } from "@/components/base/buttons/button";
import { BackgroundPattern } from "@/components/shared-assets/background-patterns";
import { getIcon } from "@/lib/icons";
---

<Base title="Page not found — Spolvero" description="This page doesn't exist." noindex>
  <section class="relative overflow-hidden bg-primary py-24 md:py-32">
    <BackgroundPattern pattern="grid" size="lg" className="absolute top-0 left-1/2 -translate-x-1/2 text-secondary" />
    <div class="relative container-page flex flex-col items-center text-center">
      <span class="text-md font-semibold text-brand-secondary">404 error</span>
      <h1 class="mt-3 text-display-md font-semibold text-primary md:text-display-xl">We can't find that page</h1>
      <p class="mt-4 max-w-lg text-lg text-tertiary md:mt-6 md:text-xl">The page you're looking for doesn't exist or has moved. Check the address, or head back home.</p>
      <div class="mt-8 flex flex-col-reverse gap-3 sm:flex-row md:mt-12">
        <Button href="/contact/" color="secondary" size="xl">Contact us</Button>
        <Button href="/" color="primary" size="xl" iconTrailing={getIcon("arrow")}>Go to home page</Button>
      </div>
    </div>
  </section>
</Base>
