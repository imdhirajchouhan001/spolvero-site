---
import { products } from "@/data/products";
import { tools } from "@/data/tools";
import { timers } from "@/data/timers";

const columns = [
  { title: "Apps", links: products.map((p) => ({ label: p.name, href: `/${p.slug}/` })) },
  { title: "Tools", links: tools.filter((t) => t.status === "live").map((t) => ({ label: t.name, href: `/tools/${t.slug}/` })).concat(timers.filter((t) => t.status === "live").map((t) => ({ label: t.name, href: `/tools/timers/${t.slug}/` }))).concat([{ label: "All tools", href: "/tools/" }]) },
  {
    title: "Studio",
    links: [
      { label: "Design services", href: "/#studio" },
      { label: "Start a project", href: "/contact/?topic=design" },
      { label: "Coming up", href: "/#next" },
    ],
  },
  {
    title: "Help",
    links: [
      { label: "Guides and fixes", href: "/articles/" },
      { label: "Contact and feedback", href: "/contact/" },
      { label: "Website privacy", href: "/privacy/" },
      { label: "Unspend privacy", href: "/unspend/privacy/" },
      { label: "GST Calculator privacy", href: "/gst-calculator/privacy/" },
    ],
  },
];
---

<footer class="bg-brand-section pt-12 pb-12 md:pt-16">
  <div class="container-page">
    <div class="flex flex-col gap-12 md:flex-row md:justify-between">
      <div class="flex flex-col gap-6 md:w-80">
        <a href="/" aria-label="Spolvero home" class="text-white">
          <span class="logo-mark w-[140px]"></span>
        </a>
        <p class="text-md text-tertiary_on-brand">An independent studio designing and building apps, games, web tools and software.</p>
        <a href="mailto:spolvero.design@gmail.com" class="text-md font-semibold text-secondary_on-brand hover:text-white">spolvero.design@gmail.com</a>
      </div>
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
        {columns.map((c) => (
          <div>
            <h2 class="text-sm font-semibold text-quaternary_on-brand">{c.title}</h2>
            <ul class="mt-4 flex flex-col gap-3">
              {c.links.map((l) => (
                <li><a href={l.href} class="-my-1 inline-block py-1 text-md font-semibold text-footer-button-fg hover:text-white">{l.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
    <div class="mt-12 flex flex-col-reverse justify-between gap-4 border-t border-brand-700 pt-8 md:mt-16 md:flex-row">
      <p class="text-md text-quaternary_on-brand">© 2026 Spolvero. All rights reserved.</p>
      <p class="text-md text-quaternary_on-brand">Google Play is a trademark of Google LLC.</p>
    </div>
  </div>
</footer>
