---
import Base from "@/layouts/Base.astro";
import { buttonVariants } from "@/components/ui/button";
---

<Base title="Page not found — Spolvero" description="This page doesn't exist." noindex>
  <section class="px-3 pt-2 sm:px-4">
    <div class="mesh rounded-[2rem]">
      <div class="page flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
        <p class="text-8xl font-semibold tracking-tighter text-brand/15 sm:text-9xl">404</p>
        <h1 class="mt-4 text-4xl font-semibold text-brand sm:text-5xl">This page isn't here.</h1>
        <p class="mt-4 max-w-md text-lg text-muted-foreground">Check the address, or head back to the home page.</p>
        <div class="mt-9 flex flex-wrap justify-center gap-3">
          <a href="/" class:list={[buttonVariants({ size: "lg" }), "h-12 rounded-full px-6 text-base"]}>Go to home page</a>
          <a href="/contact/" class:list={[buttonVariants({ variant: "outline", size: "lg" }), "h-12 rounded-full bg-white/70 px-6 text-base"]}>Contact us</a>
        </div>
      </div>
    </div>
  </section>
</Base>
