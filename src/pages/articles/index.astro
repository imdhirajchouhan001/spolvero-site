---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import { getIcon } from "@/lib/icons";
import ArticleThumb from "@/components/ArticleThumb.astro";
import { articlePhoto, photoSrc } from "@/data/photos";

const articles = (await getCollection("articles")).sort(
  (a, b) => new Date(b.data.published).getTime() - new Date(a.data.published).getTime(),
);
const [featured, ...rest] = articles;

const title = "Camera and Video Call Guides — Fixes That Actually Work";
const description =
  "Plain guides to the problems people have with webcams and video calls: cameras that will not start, grainy pictures, and what resolution you need.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: Astro.site!.toString() },
      { "@type": "ListItem", position: 2, name: "Articles", item: new URL("/articles/", Astro.site).toString() },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Spolvero articles",
    description,
    url: new URL("/articles/", Astro.site).toString(),
    hasPart: articles.map((a) => ({
      "@type": "Article",
      headline: a.data.title,
      description: a.data.description,
      datePublished: a.data.published,
      url: new URL(`/articles/${a.id}/`, Astro.site).toString(),
    })),
  },
];

const readable = (iso: string) =>
  new Date(iso).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
const featuredPhoto = articlePhoto(featured ? featured.data : { tool: "" });
---

<Base title={title} description={description} headerCta={{ label: "All tools", href: "/tools/" }}
  headerLabel="Guides"
  headerLabelHref="/articles/">
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <section class="relative overflow-hidden bg-secondary pt-12 pb-12 md:pt-16 md:pb-16">
    <div class="relative container-page flex flex-col items-center text-center">
      <nav aria-label="Breadcrumb" class="text-sm font-semibold text-brand-secondary">Articles</nav>
      <h1 class="mt-5 max-w-3xl text-display-sm font-semibold text-primary md:text-display-lg">
        Fixes for the things that go wrong on camera
      </h1>
      <p class="mt-4 max-w-2xl text-md text-tertiary md:text-lg">
        Written to answer the question, not to fill a page. Each one ends where the problem does, and every fix has been
        checked against the tools on this site.
      </p>
    </div>
  </section>

  <section class="py-14 md:py-20" style="background:var(--color-bg-primary)">
    <div class="container-page">
      <!-- Featured -->
      {featured && (
        <a
          href={`/articles/${featured.id}/`}
          class="group grid overflow-hidden rounded-3xl bg-primary shadow-xs ring-1 ring-secondary transition hover:shadow-lg focus-visible:outline-2 focus-visible:outline-focus-ring lg:grid-cols-2"
          data-reveal
        >
          <div class="flex flex-col justify-center p-6 md:p-10">
            <div class="flex flex-wrap items-center gap-2">
              <Badge variant="default" size="sm">Latest</Badge>
              {featured.data.tags.map((t) => <Badge variant="secondary" size="sm">{t}</Badge>)}
            </div>
            <h2 class="mt-4 text-display-xs font-semibold text-primary md:text-display-sm">{featured.data.title}</h2>
            <p class="mt-3 text-lg text-tertiary">{featured.data.description}</p>
            <p class="mt-4 text-sm text-tertiary">
              <time datetime={featured.data.updated}>{readable(featured.data.updated)}</time> · {featured.data.minutes} min read
            </p>
            <span class="mt-6 inline-flex items-center gap-1.5 text-md font-semibold text-brand-secondary">
              Read the guide <Icon name="arrow" class="size-5 transition-transform group-hover:translate-x-0.5" />
            </span>
          </div>
          {/* The photograph sits first in source order so it leads on a phone, and
              moves to the right-hand column from lg up. It replaces a panel that
              repeated the article's short answer, which the article opens with
              anyway. */}
          <div class="relative order-first min-h-56 overflow-hidden bg-[var(--muted)] lg:order-last lg:min-h-full">
            <img
              src={photoSrc(featuredPhoto, 1200)}
              srcset={[600, 900, 1200].map((w) => `${photoSrc(featuredPhoto, w)} ${w}w`).join(", ")}
              sizes="(min-width: 1024px) 50vw, 100vw"
              alt=""
              width="1200"
              height="800"
              class="absolute inset-0 size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
            />
          </div>
        </a>
      )}

      <!-- The rest -->
      <ul class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {rest.map((a) => (
          <li data-reveal>
            <a href={`/articles/${a.id}/`} class="group flex h-full flex-col overflow-hidden rounded-3xl bg-primary p-6 shadow-xs ring-1 ring-secondary transition hover:shadow-lg focus-visible:outline-2 focus-visible:outline-focus-ring">
              <ArticleThumb article={a.data} />
              <div class="flex flex-wrap gap-2">
                {a.data.tags.map((t) => <Badge variant="secondary" size="sm">{t}</Badge>)}
              </div>
              <h2 class="mt-4 text-lg font-semibold text-primary">{a.data.title}</h2>
              <p class="mt-2 text-md text-tertiary">{a.data.description}</p>
              <p class="mt-4 text-sm text-tertiary">{a.data.minutes} min read</p>
              <span class="mt-auto inline-flex items-center gap-1.5 pt-5 text-md font-semibold text-brand-secondary">
                Read <Icon name="arrow" class="size-5 transition-transform group-hover:translate-x-0.5" />
              </span>
            </a>
          </li>
        ))}
      </ul>

      <div class="mt-12 flex justify-center" data-reveal>
        <Button href="/tools/device-tests/webcam-test/" variant="default" size="xl">Test your camera<Icon name="arrow" /></Button>
      </div>
    </div>
  </section>
</Base>
