---
// One page body for every timer. Each caller supplies its own H1, answer, presets,
// tips, FAQs and reference table, so the pages are worth keeping apart.
import Timer from "@/components/timers/Timer.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import Faq from "@/components/Faq.astro";
import Icon from "@/components/Icon.astro";
import AdSlot from "@/components/AdSlot.astro";
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import { howToSteps, timers, type Timer as TimerType } from "@/data/timers";

interface Props {
  timer: TimerType;
}
const { timer } = Astro.props;
const p = timer.page!;
const siblings = timers.filter((t) => t.slug !== timer.slug);
---

<!-- Hero and tool, above the fold -->
<section class="bg-secondary pt-5 pb-12 md:pt-7 md:pb-16">
  <div class="container-page flex flex-col items-center text-center">
    <nav aria-label="Breadcrumb" class="flex flex-wrap items-center justify-center gap-2 text-sm font-semibold text-tertiary">
      <a href="/tools/" class="hover:text-tertiary_hover">Tools</a>
      <span aria-hidden="true">/</span>
      <a href="/tools/timers/" class="hover:text-tertiary_hover">Timers</a>
      <span aria-hidden="true">/</span>
      <span class="text-brand-secondary">{timer.name}</span>
    </nav>

    <h1 class="mt-4 max-w-4xl text-display-sm font-semibold text-primary md:text-display-md">{p.h1}</h1>
    <p class="mt-3 max-w-2xl text-md text-tertiary md:text-lg">{p.intro}</p>
  </div>

  <div class="mt-6 md:mt-8">
    <Timer mode={timer.mode} presets={p.presets} defaultSeconds={p.defaultSeconds} slug={timer.slug} accent={timer.accent} />
  </div>

  <div class="container-page mt-10 max-w-5xl md:mt-12">
    <AdSlot placement="below-results" />
  </div>
</section>

<!-- The short answer -->
<section class="bg-secondary pb-14 md:pb-20">
  <div class="container-page">
    <div class="mx-auto max-w-3xl rounded-3xl bg-primary p-6 shadow-xs ring-1 ring-secondary md:p-8" data-reveal>
      <h2 class="text-display-xs font-semibold text-primary">The short answer</h2>
      <p class="mt-3 text-lg text-tertiary">{p.answer}</p>
    </div>

    <div class="mt-14 md:mt-20">
      <SectionHeader eyebrow="How to use it" title="Three steps to a timer on the wall" />
      <ol class="mx-auto mt-10 grid max-w-5xl gap-6 md:mt-12 md:grid-cols-3">
        {howToSteps.map((s, i) => (
          <li class="flex flex-col rounded-3xl bg-primary p-6 shadow-xs ring-1 ring-secondary" data-reveal>
            <span class="grid size-11 place-items-center rounded-full text-md font-semibold text-neutral-900" style={`background:${timer.tint}`} aria-hidden="true">{i + 1}</span>
            <h3 class="mt-5 text-lg font-semibold text-primary"><span class="sr-only">Step {i + 1}: </span>{s.name}</h3>
            <p class="mt-2 text-md text-tertiary">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<div class="bg-secondary pb-14 md:pb-20">
  <div class="container-page max-w-4xl">
    <AdSlot placement="in-content" />
  </div>
</div>

<!-- Page-specific tips -->
<section class="bg-secondary pb-14 md:pb-20">
  <div class="container-page">
    <SectionHeader eyebrow="Running it well" title="Four things worth knowing" />
    <ul class="mx-auto mt-10 grid max-w-5xl gap-6 md:mt-12 md:grid-cols-2">
      {p.tips.map((t) => (
        <li class="flex gap-4 rounded-3xl bg-primary p-6 shadow-xs ring-1 ring-secondary" data-reveal>
          <span class="grid size-10 shrink-0 place-items-center rounded-full text-neutral-900" style={`background:${timer.tint}`} aria-hidden="true">
            <Icon name="check" class="size-5" />
          </span>
          <div>
            <h3 class="text-lg font-semibold text-primary">{t.title}</h3>
            <p class="mt-1.5 text-md text-tertiary">{t.body}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- Reference table: the citable part of the page -->
<slot name="reference" />

<!-- The promise that competitors with ad-funded fullscreen cannot copy -->
<section class="bg-secondary pb-14 md:pb-20">
  <div class="container-page">
    <div class="mx-auto grid max-w-5xl gap-8 rounded-3xl bg-brand-section px-6 py-10 md:grid-cols-2 md:px-10" data-reveal>
      <div>
        <h2 class="text-display-xs font-semibold text-primary_on-brand">No ads on your big screen</h2>
        <p class="mt-3 text-md text-tertiary_on-brand">
          Ads pay for this page, and they stay on this page. The moment the timer goes fullscreen there is nothing on
          screen but the time — no banners, no navigation, no surprises in front of a room.
        </p>
      </div>
      <ul class="flex flex-col gap-3 self-center">
        {[
          "Fullscreen shows the timer alone",
          "Ad sounds can never clash with the alarm",
          "Saved times stay on your device — no account",
          "Works with an ad blocker, and offline once loaded",
        ].map((x) => (
          <li class="flex gap-3 text-md text-primary_on-brand">
            <span class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-white/15"><Icon name="check" class="size-3.5" /></span>
            {x}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<!-- FAQ -->
<section id="faq" class="bg-secondary pb-14 md:pb-20">
  <div class="container-page grid gap-10 lg:grid-cols-[1fr_2fr] lg:gap-16">
    <div>
      <SectionHeader align="left" eyebrow="FAQ" title="Questions people ask" lede="Anything we've missed?" />
      <div class="mt-6" data-reveal>
        <Button href={`/contact/?topic=bug&app=${timer.slug}`} variant="outline" size="lg">Tell us</Button>
      </div>
    </div>
    <div data-reveal>
      <Faq id="timer-faq" items={p.faqs} />
    </div>
  </div>
</section>

<!-- Sibling timers -->
<section class="bg-secondary pb-16 md:pb-24">
  <div class="container-page">
    <h2 class="text-display-xs font-semibold text-primary" data-reveal>Other timers</h2>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {siblings.map((t) => (
        <li data-reveal>
          <a
            href={t.status === "live" ? `/tools/timers/${t.slug}/` : "/tools/timers/"}
            class="group flex h-full flex-col rounded-3xl bg-primary p-5 shadow-xs ring-1 ring-secondary transition hover:shadow-lg focus-visible:outline-2 focus-visible:outline-focus-ring"
          >
            <div class="flex items-start justify-between gap-3">
              <span class="grid size-11 place-items-center rounded-2xl text-neutral-900" style={`background:${t.tint}`} aria-hidden="true">
                <Icon name={t.icon} class="size-5" />
              </span>
              {t.status === "live"
                ? <Badge variant="success" size="sm">Live</Badge>
                : <Badge variant="secondary" size="sm">Soon</Badge>}
            </div>
            <p class="mt-4 text-md font-semibold text-primary">{t.name}</p>
            <p class="mt-1 text-sm text-tertiary">{t.tagline}</p>
          </a>
        </li>
      ))}
    </ul>

    <div class="mx-auto mt-14 flex max-w-3xl flex-col items-center gap-4 rounded-3xl bg-primary px-6 py-8 text-center shadow-xs ring-1 ring-secondary md:flex-row md:justify-between md:text-left" data-reveal>
      <p class="text-md text-tertiary">
        <span class="font-semibold text-primary">Built by Spolvero studio.</span> We design apps and websites for other people too.
      </p>
      <Button href="/contact/?topic=design" variant="default" size="lg">Need an app designed?<Icon name="arrow" /></Button>
    </div>
  </div>
</section>
