---
// FAQ built on Flowbite's accordion behaviour (data-accordion), styled with Untitled UI tokens.
interface Props {
  id: string;
  items: { q: string; a: string }[];
}
const { id, items } = Astro.props;
---

<div id={id} data-accordion="collapse" data-active-classes="text-primary" data-inactive-classes="text-primary" class="divide-y divide-secondary border-y border-secondary">
  {items.map((item, i) => (
    <div>
      <h3>
        <button
          type="button"
          id={`${id}-h${i}`}
          class="group flex w-full items-center justify-between gap-6 py-6 text-left text-lg font-semibold text-primary"
          data-accordion-target={`#${id}-b${i}`}
          aria-expanded={i === 0 ? "true" : "false"}
          aria-controls={`${id}-b${i}`}
        >
          <span>{item.q}</span>
          <span class="grid size-6 shrink-0 place-items-center rounded-full border-2 border-current text-fg-quaternary" aria-hidden="true">
            <svg data-accordion-icon class="size-3.5 transition-transform group-aria-expanded:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 9l6 6 6-6" /></svg>
          </span>
        </button>
      </h3>
      <div id={`${id}-b${i}`} class:list={[i !== 0 && "hidden"]} aria-labelledby={`${id}-h${i}`}>
        <p class="pr-12 pb-6 text-md text-tertiary">{item.a}</p>
      </div>
    </div>
  ))}
</div>
