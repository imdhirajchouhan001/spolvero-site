# Ads are off until these are set. Leave them empty and no ad code ships at all.
# Apply for AdSense only once 10+ content pages plus the privacy and cookie pages are live.
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT_BELOW_RESULTS=
PUBLIC_ADSENSE_SLOT_IN_CONTENT=
PUBLIC_ADSENSE_SLOT_SIDEBAR=

# Set to 1 to draw the slots as labelled boxes without loading AdSense (placement check only).
PUBLIC_ADS_PREVIEW=

# --- Interrupting formats. Both off unless set to 1. Once per session each. ---
PUBLIC_ADS_ANCHOR=
PUBLIC_ADSENSE_SLOT_ANCHOR=
PUBLIC_ADS_ANCHOR_DELAY=10
PUBLIC_ADS_INTERSTITIAL=
PUBLIC_ADSENSE_SLOT_INTERSTITIAL=
PUBLIC_ADS_INTERSTITIAL_AFTER=6
