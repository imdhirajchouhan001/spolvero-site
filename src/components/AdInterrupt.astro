---
// The two interrupting ad formats: a dismissible bottom strip, and a full-screen
// panel that appears once the reader is well down the page.
//
// Both are off unless switched on in .env, both are capped at once per session,
// and both close on Escape, on the close button, or on a click outside. Neither
// ever appears while a camera test result is on screen — covering the answer the
// visitor came for would defeat the page.
import Icon from "@/components/Icon.astro";
import {
  adsenseClient, adsPreview, adsAnchor, adsInterstitial,
  interruptSlots, interstitialAfterSections, anchorDelaySeconds,
} from "@/data/ads";

// Content pages carry ads; pages that are not content do not. Error pages and
// bare form pages are excluded because AdSense policy prohibits ads on screens
// with little or no content, and a breach found during review is a rejection.
const path = Astro.url.pathname;
const excluded = ["/404", "/contact"];
const monetised = !excluded.some((p) => path.startsWith(p));

// Each format needs its own ad unit to exist, otherwise it would fire an ad
// request with no slot. Preview mode draws the boxes without any unit.
const showAnchor = monetised && adsAnchor && (adsPreview || Boolean(adsenseClient && interruptSlots.anchor));
const showInterstitial = monetised && adsInterstitial && (adsPreview || Boolean(adsenseClient && interruptSlots.interstitial));
---

{showAnchor && (
  <aside
    class="fixed inset-x-0 bottom-0 z-50 hidden overflow-hidden border-t border-secondary bg-primary shadow-lg"
    style="padding-bottom:env(safe-area-inset-bottom)"
    data-ad-anchor
    data-delay={anchorDelaySeconds}
    aria-label="Advertisement"
  >
    {/*
      The close button is positioned against the strip itself rather than sitting
      in the row beside the ad.

      It used to be a flex sibling of the ad. The ad box was `flex-1` with the
      default `min-width: auto`, so it could not shrink below the width of the
      iframe AdSense injects, and on a 375px phone that pushed the button to
      x=431 — ninety-two pixels past the right edge of the screen, with no
      scrolling that could reach it. The strip was undismissable on a phone while
      looking fine on a desktop, which is exactly how it went unnoticed.

      Positioned here it cannot be pushed anywhere by anything the ad network
      decides to inject. The row reserves `pr-14` so the ad never sits under it,
      because an ad partly covered by a control is both worse to look at and a
      policy problem.
    */}
    <button
      type="button"
      class="absolute top-1/2 right-2 z-10 grid size-11 -translate-y-1/2 place-items-center rounded-full bg-primary text-fg-quaternary ring-1 ring-secondary transition hover:bg-secondary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-ring"
      data-ad-close
      aria-label="Close advertisement"
    >
      <Icon name="close" class="size-5" />
    </button>

    <div class="container-page flex items-center gap-3 py-2 pr-14">
      <span class="text-xs text-quaternary">Ad</span>
      {/* min-w-0 lets the ad box shrink to the space that is actually free. Without
          it the box reports the injected iframe's width as its minimum and the row
          overflows the screen. It also means AdSense measures the real width when
          the unit fills, so it asks for a creative that fits. */}
      <div class="min-h-[50px] min-w-0 flex-1 overflow-hidden">
        {adsPreview ? (
          <div class="grid h-[50px] w-full place-items-center rounded-xl border-2 border-dashed border-primary text-xs font-semibold text-quaternary">
            anchor · 320×50 reserved
          </div>
        ) : (
          /* No data-full-width-responsive here, unlike the in-content units: that
             flag tells AdSense to ignore its container and span the viewport,
             which is the opposite of what a strip sharing a row with a control
             needs. */
          <ins
            class="adsbygoogle block w-full"
            data-ad-client={adsenseClient}
            data-ad-slot={interruptSlots.anchor}
            data-ad-format="horizontal"
          ></ins>
        )}
      </div>
    </div>
  </aside>
)}

{showInterstitial && (
  <div class="fixed inset-0 z-50 hidden items-center justify-center bg-neutral-950/60 p-4 backdrop-blur-sm" data-ad-interstitial data-after={interstitialAfterSections}>
    <div class="relative w-full max-w-lg rounded-3xl bg-primary p-5 shadow-lg" role="dialog" aria-modal="true" aria-label="Advertisement">
      <div class="flex items-center justify-between">
        <span class="text-xs text-quaternary">Ad</span>
        <button type="button" class="grid size-11 place-items-center rounded-full text-fg-quaternary transition hover:bg-secondary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-ring" data-ad-close aria-label="Close advertisement">
          <Icon name="close" class="size-5" />
        </button>
      </div>
      <div class="mt-3 min-h-[250px]">
        {adsPreview ? (
          <div class="grid min-h-[250px] w-full place-items-center rounded-2xl border-2 border-dashed border-primary text-sm font-semibold text-quaternary">
            interstitial · 300×250 reserved
          </div>
        ) : (
          <ins
            class="adsbygoogle block w-full"
            data-ad-client={adsenseClient}
            data-ad-slot={interruptSlots.interstitial}
            data-ad-format="rectangle"
          ></ins>
        )}
      </div>
      <p class="mt-3 text-center text-sm text-tertiary">
        <button type="button" class="font-semibold text-brand-secondary hover:underline" data-ad-close>Close and continue</button>
      </p>
    </div>
  </div>
)}

{(showAnchor || showInterstitial) && (
  <script is:inline define:vars={{ preview: adsPreview }}>
    (function () {
      var KEY_A = "spolvero.ad.anchor.closed";
      var KEY_I = "spolvero.ad.interstitial.seen";
      var read = function (k) { try { return sessionStorage.getItem(k); } catch (e) { return null; } };
      var write = function (k) { try { sessionStorage.setItem(k, "1"); } catch (e) {} };

      // Never interrupt while a finished test result is on screen.
      var resultOnScreen = function () {
        var card = document.querySelector('[data-webcam][data-state="live"]');
        if (!card) return false;
        var r = card.getBoundingClientRect();
        return r.bottom > 0 && r.top < innerHeight;
      };

      // A running timer is being shown to a room. Nothing may cover it, and an ad
      // carrying sound would clash with the alarm, so both formats stand down.
      var timerRunning = function () {
        return document.documentElement.hasAttribute("data-timer-running");
      };

      var fill = function (el) {
        if (preview || el.dataset.adFilled !== undefined) return;
        el.dataset.adFilled = "";
        try { (window.adsbygoogle = window.adsbygoogle || []).push({}); } catch (e) {}
      };

      var wire = function (el, key) {
        el.querySelectorAll("[data-ad-close]").forEach(function (b) {
          b.addEventListener("click", function () { close(el, key); });
        });
      };
      var close = function (el, key) {
        el.classList.add("hidden");
        el.classList.remove("flex");
        write(key);
        if (lastFocus && lastFocus.focus) lastFocus.focus();
      };
      var lastFocus = null;

      // ---- anchor: a strip that slides up after a delay, and stays closed ----
      var anchor = document.querySelector("[data-ad-anchor]");
      if (anchor && !read(KEY_A)) {
        wire(anchor, KEY_A);
        setTimeout(function () {
          if (read(KEY_A) || timerRunning()) return;
          anchor.classList.remove("hidden");
          fill(anchor);
        }, (Number(anchor.dataset.delay) || 10) * 1000);
      }

      // ---- interstitial: only after real engagement, once per session ----
      var inter = document.querySelector("[data-ad-interstitial]");
      if (inter && !read(KEY_I)) {
        wire(inter, KEY_I);
        var need = Number(inter.dataset.after) || 6;
        var sections = Array.prototype.slice.call(document.querySelectorAll("main section"));
        var passed = 0;
        var open = function () {
          if (read(KEY_I) || resultOnScreen() || timerRunning()) return;
          lastFocus = document.activeElement;
          inter.classList.remove("hidden");
          inter.classList.add("flex");
          fill(inter);
          var btn = inter.querySelector("[data-ad-close]");
          if (btn) btn.focus();
        };
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            io.unobserve(e.target);
            passed++;
            if (passed >= need) { io.disconnect(); open(); }
          });
        }, { threshold: 0.4 });
        sections.forEach(function (s) { io.observe(s); });

        // Escape closes it, and a click on the backdrop does too.
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && !inter.classList.contains("hidden")) close(inter, KEY_I);
        });
        inter.addEventListener("click", function (e) { if (e.target === inter) close(inter, KEY_I); });
      }

      document.addEventListener("spolvero:timer", function (e) {
        if (!e.detail || !e.detail.running) return;
        if (anchor) anchor.classList.add("hidden");
        if (inter) { inter.classList.add("hidden"); inter.classList.remove("flex"); }
      });
    })();
  </script>
)}
