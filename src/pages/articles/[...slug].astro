---
import { getCollection, render } from "astro:content";
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import AdSlot from "@/components/AdSlot.astro";
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import { getIcon } from "@/lib/icons";
import ScrollableTables from "@/components/ScrollableTables.astro";
import ArticleThumb from "@/components/ArticleThumb.astro";
import { articlePhoto, photoSrc } from "@/data/photos";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  return articles.map((entry) => ({ params: { slug: entry.id }, props: { entry, all: articles } }));
}

const { entry, all } = Astro.props;
const { Content } = await render(entry);
const a = entry.data;
const photo = articlePhoto(a);
const url = new URL(`/articles/${entry.id}/`, Astro.site).toString();
const site = Astro.site!.toString();

// Three more to read, preferring ones that share a tag.
const others = all
  .filter((o) => o.id !== entry.id)
  .sort((x, y) => {
    const shared = (e: typeof x) => e.data.tags.filter((t) => a.tags.includes(t)).length;
    return shared(y) - shared(x);
  })
  .slice(0, 3);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: a.title,
    description: a.description,
    datePublished: a.published,
    dateModified: a.updated,
    author: { "@type": "Organization", name: "Spolvero", url: site },
    publisher: { "@id": `${site}#organization` },
    mainEntityOfPage: url,
    inLanguage: "en",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site },
      { "@type": "ListItem", position: 2, name: "Articles", item: new URL("/articles/", site).toString() },
      { "@type": "ListItem", position: 3, name: a.title, item: url },
    ],
  },
];

const readable = (iso: string) =>
  new Date(iso).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
---

<Base title={`${a.seoTitle ?? a.title} — Spolvero`} description={a.description} image={photoSrc(photo, 1200, 630).replace("fm=webp", "fm=jpg")} headerCta={{ label: a.toolCta, href: a.tool }}
  headerLabel="Guides"
  headerLabelHref="/articles/">
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <article>
    <!-- Header -->
    <header class="bg-secondary pt-8 pb-10 md:pt-10 md:pb-12">
      <div class="container-page mx-auto max-w-3xl">
        <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-sm font-semibold text-tertiary">
          <a href="/articles/" class="hover:text-tertiary_hover">Articles</a>
          <span aria-hidden="true">/</span>
          <span class="text-brand-secondary">{a.tags[0] ?? "Guide"}</span>
        </nav>

        <h1 class="mt-5 text-display-sm font-semibold text-primary md:text-display-md">{a.title}</h1>

        <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-tertiary">
          <span class="font-semibold text-secondary">Spolvero</span>
          <span aria-hidden="true">·</span>
          <time datetime={a.updated}>Updated {readable(a.updated)}</time>
          <span aria-hidden="true">·</span>
          <span>{a.minutes} min read</span>
        </div>
      </div>
    </header>

    <!-- The photograph. Wider than the text column so it reads as a break
         between the headline and the article, not as another block of it. It
         belongs to the tool the article is about; the credit is shown although
         the Unsplash licence does not require it. -->
    <figure class="bg-secondary pb-10 md:pb-12">
      <div class="container-page mx-auto max-w-5xl">
        <div class="aspect-[16/9] overflow-hidden rounded-3xl bg-[var(--muted)]">
          <img
            src={photoSrc(photo, 1600)}
            srcset={[640, 960, 1280, 1600].map((w) => `${photoSrc(photo, w)} ${w}w`).join(", ")}
            sizes="(min-width: 1024px) 1024px, 100vw"
            alt={photo.alt}
            width="1600"
            height="900"
            fetchpriority="high"
            class="size-full object-cover"
          />
        </div>
        <figcaption class="mt-3 text-sm text-tertiary">
          Photo by <a href={photo.creditUrl} rel="noopener" class="underline hover:text-secondary">{photo.credit}</a>{" on "}<a href={photo.unsplashUrl} rel="noopener" class="underline hover:text-secondary">Unsplash</a>
        </figcaption>
      </div>
    </figure>

    <!-- The short answer, first thing on the page -->
    <div class="bg-secondary pb-12 md:pb-16">
      <div class="container-page mx-auto max-w-3xl">
        <div class="rounded-3xl bg-primary p-6 shadow-xs ring-1 ring-secondary md:p-8">
          <h2 class="text-sm font-semibold text-brand-secondary">The short answer</h2>
          <p class="mt-2 text-lg text-tertiary">{a.answer}</p>
          <div class="mt-5">
            <Button href={a.tool} variant="default" size="lg"><Icon name="camera" />{a.toolCta}</Button>
          </div>
        </div>
      </div>
    </div>

    <!-- Body -->
    <div class="bg-secondary pb-14 md:pb-20">
      <div class="container-page mx-auto max-w-3xl">
        <div class="prose md:prose-lg [&_table]:block [&_table]:overflow-x-auto">
          <Content />
        </div>

        <div class="mt-12">
          <AdSlot placement="in-content" />
        </div>

        <!-- Tool CTA at the end, where the reader now wants it -->
        <aside class="mt-12 flex flex-col gap-4 rounded-3xl bg-brand-section px-6 py-8 md:flex-row md:items-center md:justify-between md:px-8">
          <div>
            <p class="text-lg font-semibold text-primary_on-brand">Check your camera in 3 seconds</p>
            <p class="mt-1 text-md text-tertiary_on-brand">Score, resolution, frame rate and lighting. Nothing uploaded.</p>
          </div>
          <Button href={a.tool} variant="outline" size="lg">{a.toolCta}<Icon name="arrow" /></Button>
        </aside>

        {a.tags.length > 0 && (
          <ul class="mt-10 flex flex-wrap gap-2">
            {a.tags.map((t) => (
              <li><Badge variant="secondary" size="md">{t}</Badge></li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </article>

  <!-- Keep reading -->
  <section class="bg-secondary pb-16 md:pb-24">
    <div class="container-page">
      <h2 class="text-display-xs font-semibold text-primary" data-reveal>Keep reading</h2>
      <ul class="mt-6 grid gap-6 md:grid-cols-3">
        {others.map((o) => (
          <li data-reveal>
            <a href={`/articles/${o.id}/`} class="group flex h-full flex-col overflow-hidden rounded-3xl bg-primary p-6 shadow-xs ring-1 ring-secondary transition hover:shadow-lg focus-visible:outline-2 focus-visible:outline-focus-ring">
              <ArticleThumb article={o.data} />
              <p class="text-sm font-semibold text-brand-secondary">{o.data.tags[0] ?? "Guide"}</p>
              <h3 class="mt-2 text-lg font-semibold text-primary">{o.data.title}</h3>
              <p class="mt-2 text-md text-tertiary">{o.data.description}</p>
              <span class="mt-auto inline-flex items-center gap-1.5 pt-5 text-md font-semibold text-brand-secondary">
                Read <Icon name="arrow" class="size-5 transition-transform group-hover:translate-x-0.5" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <ScrollableTables />
</Base>
