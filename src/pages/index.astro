---
// The homepage.
//
// It used to run to fifteen sections and carry the apps, the studio, the company
// FAQ and the roadmap, because none of those had a page of its own. They do now —
// /apps/, /studio/, /about/ — and this page went back to one job: say what
// Spolvero is, then send you to the right place.
//
// Order is deliberate. Tools come before apps because the tools are what brings
// anyone here; they used to sit sixth, below a privacy table about the apps.
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import Screen from "@/components/Screen.astro";
import NotifyForm from "@/components/NotifyForm.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import AdSlot from "@/components/AdSlot.astro";
import SplitText from "@/components/SplitText";
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import { BadgeGroup } from "@/components/base/badges/badge-groups";
import { BackgroundPattern } from "@/components/shared-assets/background-patterns";
import { getIcon } from "@/lib/icons";
import { products, getProduct } from "@/data/products";
import { deviceTests, audioTools, toolHref } from "@/data/tools";
import { timers } from "@/data/timers";
import { pillars } from "@/data/home";
import { getCollection } from "astro:content";

const live = products.filter((p) => p.status === "live");
const liveDevice = deviceTests.filter((t) => t.status === "live");
const liveTimers = timers.filter((t) => t.status === "live");
const liveAudio = audioTools.filter((t) => t.status === "live");
const liveTotal = liveDevice.length + liveTimers.length + liveAudio.length;

const latestArticles = (await getCollection("articles"))
  .sort((a, b) => new Date(b.data.published).getTime() - new Date(a.data.published).getTime())
  .slice(0, 3);

// Centre of the fan sits in the middle; every product here needs at least one screenshot.
const fan = [
  { p: getProduct("enough")!, i: 0 },
  { p: getProduct("unspend")!, i: 0 },
  { p: getProduct("exact")!, i: 0 },
];
const fanCentre = (fan.length - 1) / 2;
const featured = products[0];

// The three sets, named by what a visitor wants rather than by how they are built.
const toolSets = [
  {
    label: "Device tests",
    href: "/tools/device-tests/",
    icon: "camera",
    tint: "#ffeadb",
    count: liveDevice.length,
    blurb: "Camera, microphone, speakers, keyboard and screen — answered in seconds, with the fix underneath when the answer is no.",
  },
  {
    label: "Timers",
    href: "/tools/timers/",
    icon: "clock",
    tint: "#e2f0ff",
    count: liveTimers.length,
    blurb: "Big enough for the back of the room. Classroom countdowns, speech lights and an exam clock. Fullscreen is ad-free.",
  },
  {
    label: "Audio",
    href: "/tools/audio/",
    icon: "message",
    tint: "#dff5ea",
    count: liveAudio.length,
    blurb: "Record, trim the ends and download MP3 or WAV. The audio never leaves the tab.",
  },
];
---

<Base
  title="Spolvero — Small Apps, Free Web Tools and Design Studio"
  description="Spolvero is an independent studio: private-by-default Android apps, free browser tools that never upload your data, and UI/UX design work for others."
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-primary pt-16 md:pt-24">
    <BackgroundPattern pattern="grid" size="lg" className="absolute top-0 left-1/2 hidden -translate-x-1/2 text-border-secondary opacity-70 md:block" />
    <BackgroundPattern pattern="grid" size="md" className="absolute top-0 left-1/2 -translate-x-1/2 text-border-secondary opacity-70 md:hidden" />

    <div class="relative container-page flex flex-col items-center text-center">
      <a href="/apps/" class="rounded-full outline-focus-ring focus-visible:outline-2 focus-visible:outline-offset-2" data-reveal>
        <BadgeGroup addonText={`${products.length} apps`} color="brand" theme="modern" size="lg" iconTrailing={getIcon("arrow")}>
          {`${live.length} live on Google Play, more on the way`}
        </BadgeGroup>
      </a>

      <SplitText
        client:load
        tag="h1"
        text="Small apps, carefully made."
        splitType="words, chars"
        delay={24}
        duration={0.9}
        from={{ opacity: 0, y: 32 }}
        to={{ opacity: 1, y: 0 }}
        rootMargin="0px"
        threshold={0}
        className="mt-6 max-w-4xl text-display-md font-semibold text-primary md:text-display-2xl"
      />

      <p class="mt-4 max-w-3xl text-lg text-tertiary md:mt-6 md:text-xl" data-reveal>
        Spolvero is an independent studio. We design and build apps, games, web tools and software, and we design for other people too.
      </p>

      <div class="mt-8 flex w-full flex-col-reverse items-stretch gap-3 sm:w-auto sm:flex-row sm:items-start md:mt-12" data-reveal>
        <Button href="/studio/" variant="outline" size="xl"><Icon name="pen" />Hire us for design</Button>
        <Button href="/tools/" variant="default" size="xl">Try a free tool</Button>
      </div>

      <div class="relative mt-16 h-[380px] w-full max-w-5xl md:mt-20 md:h-[520px]" data-fan aria-label="Screens from Spolvero apps">
        {fan.map(({ p, i }, idx) => (
          <div
            class="absolute bottom-0 left-1/2 w-[160px] origin-bottom md:w-[240px]"
            data-fan-item={idx - fanCentre}
            style={`z-index:${10 - Math.abs(idx - fanCentre)};transform:translateX(-50%)`}
          >
            <Screen product={p} shot={p.screenshots[i]} />
          </div>
        ))}
      </div>
    </div>
    <div class="relative h-px bg-border-secondary"></div>
  </section>

  <!-- The three routes off this page. Nothing here explains itself twice. -->
  <section id="what-we-do" class="bg-primary py-16 md:py-24">
    <div class="container-page">
      <SectionHeader
        eyebrow="What we do"
        title="One studio, three kinds of work"
        lede="We make our own apps, publish free tools anyone can use, and design products for other people. Each one makes the other two better."
      />
      <ul class="mt-12 grid gap-6 md:mt-16 md:grid-cols-3">
        {pillars.map((x) => (
          <li data-reveal>
            <a href={x.href} class="group flex h-full flex-col rounded-3xl bg-secondary p-6 transition hover:shadow-lg focus-visible:outline-2 focus-visible:outline-focus-ring md:p-8">
              <span class="grid size-14 place-items-center rounded-2xl text-neutral-900" style={`background:${x.tint}`} aria-hidden="true">
                <Icon name={x.icon} class="size-7" />
              </span>
              <p class="mt-6 text-sm font-semibold text-brand-secondary">{x.kind}</p>
              <h2 class="mt-1 text-xl font-semibold text-primary">{x.title}</h2>
              <p class="mt-3 text-md text-tertiary">{x.body}</p>
              <p class="mt-4 text-sm font-medium text-secondary">{x.proof}</p>
              <span class="mt-auto inline-flex items-center gap-1.5 pt-6 text-md font-semibold text-brand-secondary">
                {x.cta} <Icon name="arrow" class="size-5 transition-transform group-hover:translate-x-0.5" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Free tools: the pages that bring people to the site at all, so they lead. -->
  <section id="tools" class="py-16 md:py-24" style="background:var(--color-wash-soft)">
    <div class="container-page">
      <SectionHeader
        eyebrow="Free tools"
        icon="wrench"
        title={`${liveTotal} tools, *free forever*`}
        lede="No sign-up, nothing uploaded, and no feature held back. Ads on the page pay for them, never the person using them."
      />
      <ul class="mt-12 grid gap-6 md:mt-16 md:grid-cols-3">
        {toolSets.map((s) => (
          <li data-reveal>
            <a href={s.href} class="group flex h-full flex-col rounded-3xl bg-primary p-6 shadow-xs ring-1 ring-secondary transition hover:shadow-lg focus-visible:outline-2 focus-visible:outline-focus-ring md:p-8">
              <div class="flex items-start justify-between gap-4">
                <span class="grid size-14 place-items-center rounded-2xl text-neutral-900" style={`background:${s.tint}`} aria-hidden="true">
                  <Icon name={s.icon} class="size-7" />
                </span>
                <Badge variant="success" size="sm">{s.count} live</Badge>
              </div>
              <h2 class="mt-6 text-xl font-semibold text-primary">{s.label}</h2>
              <p class="mt-3 text-md text-tertiary">{s.blurb}</p>
              <span class="mt-auto inline-flex items-center gap-1.5 pt-6 text-md font-semibold text-brand-secondary">
                Open {s.label.toLowerCase()} <Icon name="arrow" class="size-5 transition-transform group-hover:translate-x-0.5" />
              </span>
            </a>
          </li>
        ))}
      </ul>
      <ul class="mx-auto mt-10 flex max-w-3xl flex-wrap justify-center gap-2" data-reveal>
        {[...liveDevice, ...liveAudio].map((t) => (
          <li>
            <a href={toolHref(t)} class="inline-flex rounded-sm bg-primary px-4 py-2 text-sm font-semibold text-secondary ring-1 ring-secondary transition hover:bg-primary_hover">{t.name}</a>
          </li>
        ))}
      </ul>
      <div class="mt-10 flex justify-center" data-reveal>
        <Button href="/tools/" variant="outline" size="lg">Every free tool<Icon name="arrow" /></Button>
      </div>
    </div>
  </section>

  <div class="bg-primary pt-16 md:pt-24">
    <div class="container-page max-w-4xl">
      <AdSlot placement="in-content" />
    </div>
  </div>

  <!-- Apps, as a teaser. The full set lives on /apps/. -->
  <section id="apps" class="bg-primary py-16 md:py-24">
    <div class="container-page">
      <SectionHeader eyebrow="Our apps" icon="phone" title="Each one does *one job* well" lede={`${products.length} apps built here, ${live.length} live on Google Play so far.`} />
      <div class="mt-12 grid items-center gap-10 rounded-3xl bg-secondary p-6 md:mt-16 md:p-12 lg:grid-cols-2" data-reveal>
        <div>
          <Badge variant="success" size="md">Live on Google Play</Badge>
          <h3 class="mt-4 text-display-xs font-semibold text-primary md:text-display-sm">{featured.name} — {featured.tagline}</h3>
          <p class="mt-4 text-lg text-tertiary">{featured.summary}</p>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <Button href={`/${featured.slug}/`} variant="default" size="xl">About {featured.name}<Icon name="arrow" /></Button>
            <Button href="/apps/" variant="outline" size="xl">All {products.length} apps</Button>
          </div>
        </div>
        <div class="flex justify-center gap-4">
          <Screen product={featured} shot={featured.screenshots[0]} class="w-[46%] max-w-[220px] self-start" />
          <Screen product={featured} shot={featured.screenshots[1]} class="mt-10 w-[46%] max-w-[220px] self-start" />
        </div>
      </div>
    </div>
  </section>

  <!-- Guides: the content cluster, linked from the homepage so it gets crawled -->
  <section id="guides" class="py-16 md:py-24" style="background:var(--color-wash)">
    <div class="container-page">
      <SectionHeader
        eyebrow="Guides"
        title="Answers to the things that actually go wrong"
        lede="Written to solve the problem and then stop. Every fix has been checked against the tools on this site."
      />
      <ul class="mt-12 grid gap-6 md:mt-16 md:grid-cols-3">
        {latestArticles.map((a) => (
          <li data-reveal>
            <a href={`/articles/${a.id}/`} class="group flex h-full flex-col rounded-3xl bg-primary p-6 shadow-xs ring-1 ring-secondary transition hover:shadow-lg focus-visible:outline-2 focus-visible:outline-focus-ring">
              <p class="text-sm font-semibold text-brand-secondary">{a.data.tags[0] ?? "Guide"}</p>
              <h2 class="mt-2 text-lg font-semibold text-primary">{a.data.title}</h2>
              <p class="mt-2 text-md text-tertiary">{a.data.description}</p>
              <span class="mt-auto inline-flex items-center gap-1.5 pt-5 text-md font-semibold text-brand-secondary">
                Read <Icon name="arrow" class="size-5 transition-transform group-hover:translate-x-0.5" />
              </span>
            </a>
          </li>
        ))}
      </ul>
      <div class="mt-10 flex justify-center" data-reveal>
        <Button href="/articles/" variant="outline" size="lg">All guides<Icon name="arrow" /></Button>
      </div>
    </div>
  </section>

  <!-- Newsletter CTA -->
  <section id="updates" class="bg-primary py-16 md:py-24">
    <div class="container-page">
      <div class="relative overflow-hidden rounded-3xl bg-brand-section px-6 py-10 md:px-16 md:py-16" data-reveal>
        <BackgroundPattern pattern="grid" size="md" className="absolute -top-10 right-0 text-brand-700 opacity-60" />
        <div class="relative grid gap-8 lg:grid-cols-2 lg:items-center">
          <div>
            <h2 class="text-display-xs font-semibold text-primary_on-brand md:text-display-sm">Hear when something new ships</h2>
            <p class="mt-3 text-lg text-tertiary_on-brand md:text-xl">Be first to try each new Spolvero app.</p>
          </div>
          <NotifyForm onBrand />
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const fan = document.querySelector<HTMLElement>("[data-fan]");
  const items = gsap.utils.toArray<HTMLElement>("[data-fan-item]");
  const place = (el: HTMLElement, spread = 1) => {
    const n = Number(el.dataset.fanItem);
    const wide = window.innerWidth >= 768;
    return {
      xPercent: -50 + n * (wide ? 78 : 62) * spread,
      y: Math.abs(n) * (wide ? 34 : 22),
      rotation: n * 6 * spread,
    };
  };

  const mm = gsap.matchMedia();
  mm.add("(prefers-reduced-motion: no-preference)", () => {
    items.forEach((el) => {
      gsap.fromTo(
        el,
        { xPercent: -50, y: 160, rotation: 0, opacity: 0 },
        { ...place(el), opacity: 1, duration: 1.3, ease: "expo.out", delay: 0.35 + Math.abs(Number(el.dataset.fanItem)) * 0.08 },
      );
    });
    if (fan) {
      gsap.timeline({ scrollTrigger: { trigger: fan, start: "top 60%", end: "bottom top", scrub: 0.6 } }).to(items, {
        y: (_i, el) => place(el as HTMLElement, 1.15).y - 30,
        rotation: (_i, el) => place(el as HTMLElement, 1.25).rotation,
        xPercent: (_i, el) => place(el as HTMLElement, 1.12).xPercent,
        ease: "none",
      });
    }
  });
  mm.add("(prefers-reduced-motion: reduce)", () => {
    items.forEach((el) => gsap.set(el, place(el)));
  });
</script>
